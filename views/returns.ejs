<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>

<%
    const returnRows = Array.isArray(returns) ? returns : [];
    const averageReturn = returnRows.length ? Number(total) / returnRows.length : 0;
    const todayKey = new Date().toISOString().slice(0, 10);
    const todayReturns = returnRows.filter(
        item => new Date(item.created_at).toISOString().slice(0, 10) === todayKey
    ).length;
    const returnCustomers = new Set(
        returnRows.map(item => item.customer_name).filter(Boolean)
    ).size;
%>
<div class="col content returns-page">
    <div class="returns-shell">
    <header class="returns-header">
        <div>
            <div class="returns-eyebrow"><i class="bi bi-arrow-counterclockwise"></i>История операций</div>
            <h1>Возвраты</h1>
            <p>Оформленные возвраты товаров и денежных средств по чекам</p>
        </div>
        <a href="/sales" class="returns-primary-action">
            <i class="bi bi-receipt"></i>К продажам
        </a>
    </header>

    <section class="returns-metrics">
        <div class="returns-metric">
            <span class="returns-metric-icon returns-metric-icon--primary"><i class="bi bi-arrow-return-left"></i></span>
            <span class="returns-metric-copy"><span>Количество возвратов</span><strong><%= returnRows.length %></strong></span>
        </div>
        <div class="returns-metric">
            <span class="returns-metric-icon returns-metric-icon--danger"><i class="bi bi-cash-stack"></i></span>
            <span class="returns-metric-copy"><span>Сумма возвратов</span><strong><%= Number(total).toLocaleString('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> ₴</strong></span>
        </div>
        <div class="returns-metric">
            <span class="returns-metric-icon returns-metric-icon--warning"><i class="bi bi-calculator"></i></span>
            <span class="returns-metric-copy"><span>Средний возврат</span><strong><%= averageReturn.toLocaleString('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> ₴</strong></span>
        </div>
        <div class="returns-metric">
            <span class="returns-metric-icon returns-metric-icon--success"><i class="bi bi-calendar-check"></i></span>
            <span class="returns-metric-copy"><span>Сегодня / клиентов</span><strong><%= todayReturns %> / <%= returnCustomers %></strong></span>
        </div>
    </section>

    <section class="returns-filters-card">
        <div class="returns-section-heading">
            <div><h2>Фильтры</h2><p>Поиск по документу, чеку, клиенту или периоду</p></div>
            <i class="bi bi-funnel"></i>
        </div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-4">
                    <input id="filterReturn" type="search" class="form-control" placeholder="№ возврата или чека">
                </div>
                <div class="col-md-3">
                    <input id="filterReturnCustomer" type="search" class="form-control" placeholder="Покупатель">
                </div>
                <div class="col-md-2">
                    <input id="filterReturnFrom" type="date" class="form-control" aria-label="Дата с">
                </div>
                <div class="col-md-2">
                    <input id="filterReturnTo" type="date" class="form-control" aria-label="Дата по">
                </div>
                <div class="col-md-1 d-grid">
                    <button id="resetReturnFilters" type="button" class="btn btn-outline-secondary" title="Сбросить фильтры"><i class="bi bi-x-lg"></i></button>
                </div>
            </div>
        </div>
    </section>

    <section class="returns-list-card">
        <div class="returns-list-heading">
            <div><h2>Журнал возвратов</h2><p>Нажмите на строку для просмотра документа</p></div>
            <span class="returns-count"><%= returnRows.length %></span>
        </div>
        <div class="table-responsive returns-table-wrapper">
            <table class="table table-hover align-middle mb-0 returns-list-table">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-3" style="width: 120px;">Возврат</th>
                        <th style="width: 120px;">Чек</th>
                        <th style="width: 170px;">Дата / Время</th>
                        <th>Клиент</th>
                        <th style="width: 160px;">Кассир</th>
                        <th style="width: 160px;">Магазин</th>
                        <th class="text-end pe-3">Сумма</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!returns.length) { %>
                        <tr><td colspan="7">
                            <div class="returns-empty"><i class="bi bi-inbox"></i><strong>Возвратов пока нет</strong><span>Новые документы появятся здесь после оформления</span></div>
                        </td></tr>
                    <% } %>
                    <% returns.forEach(item => { %>
                        <tr class="returns-row"
                            data-url="/return/<%= item.id %>"
                            data-number="<%= item.return_number || item.id %>"
                            data-invoice="<%= item.invoice_number %>"
                            data-customer="<%= item.customer_name || '' %>"
                            data-date="<%= new Date(item.created_at).toISOString().slice(0, 10) %>">
                            <td class="ps-3">
                                <span class="badge bg-light text-danger border fw-medium px-2 py-1.5">№ <%= item.return_number || item.id %></span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border fw-medium px-2 py-1.5">№ <%= item.invoice_number %></span>
                            </td>
                            <td>
                                <span class="fw-semibold text-dark">
                                    <%= new Date(item.created_at).toLocaleDateString('ru-RU') %>
                                    <i class="bi bi-clock ms-1 me-1" style="font-size: 11px;"></i><%= new Date(item.created_at).toLocaleTimeString('ru-RU', { timeZone: 'Europe/Kyiv', hour: '2-digit', minute: '2-digit' }) %>
                                </span>
                            </td>
                            <td>
                                <div class="fw-medium text-dark">
                                    <i class="bi bi-person text-muted me-1"></i><%= item.customer_name || 'Розничный покупатель' %>
                                </div>
                            </td>
                            <td>
                                <span class="text-muted">
                                    <i class="bi bi-person-badge me-1"></i><%= item.user_name || 'Не указан' %>
                                </span>
                            </td>
                            <td>
                                <span class="text-muted">
                                    <i class="bi bi-shop me-1"></i><%= item.store_name || 'Не указан' %>
                                </span>
                            </td>
                            <td class="text-end pe-3 fw-bold text-danger">-<%= Number(item.total).toFixed(2) %> ₴</td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </section>
    </div>
</div>

<%- include('blocks/footer') -%>
