<!doctype html>
<html lang="en">
  <head>
    <%- include('blocks/head') -%>
  </head>
  <body>
    <div id="overlay"></div>
    <%- include('blocks/header') -%>
    <div class="container-fluid" id="cont">
      <div class="row">
        <%- include('blocks/menu') -%>
        <div class="col content">
          <div class="new-header d-flex justify-content-between align-items-center mb-3">

            <h1 class="mb-0">
                🧾 Новый чек
            </h1>

            <span class="badge bg-primary fs-4">
                <%= invoiceNumber %>
            </span>

        </div>
          <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <div class="row g-2">
                        
                        <div class="col-12 col-md-5 ">
                            
                            <select class="form-select" id="customer">
                            <option value="">Выберите покупателя</option>

                            <option value="0" selected>
                                Основной покупатель
                            </option>

                        </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <button class="btn btn-success w-100">
                                + Клиент
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <div class="position-relative">

                        <input
                            type="text"
                            id="product-search"
                            class="form-control"
                            autocomplete="off"
                            placeholder="🔍 Название, артикул или штрихкод">

                        <div
                            id="search-results"
                            class="list-group position-absolute w-100 shadow"
                            style="
                                display:none;
                                z-index:9999;
                                max-height:300px;
                                overflow-y:auto;
                            ">
                        </div>

                    </div>
                </div>
            </div>  
        <div class="card shadow-sm border-0">
            <div class="card-body border-0 p-0">

                <div class="products-table-wrapper border-0" >

                    <table class="table table-sales align-middle">

                        <thead>
                            <tr>
                                <th width="60">№</th>
                                <th>Товар</th>
                                <th width="120">Кол-во</th>
                                <th width="120">Цена</th>
                                <th width="140">Сумма</th>
                                <th width="70"></th>
                            </tr>
                        </thead>

                        <tbody id="item-products">
                        </tbody>

                    </table>

                </div>

            </div>
            
            <div class="card-footer bg-white">

                <div class="d-flex flex-column flex-md-row gap-2 justify-content-between align-items-stretch align-items-md-center">

                    <div>

                        <div class="text-muted">
                            Сдача
                        </div>

                        <strong id="change">
                            0.00 ₴
                        </strong>

                    </div>

                    <input
                        type="number"
                        id="cash"
                        class="form-control"
                        style="width:140px"
                        placeholder="Получено">

                    <select
                        name="paymentMethod"
                        class="form-select"
                        style="width:180px">

                        <option value="cash">
                            💵 Наличные
                        </option>

                        <option value="card">
                            💳 Карта
                        </option>

                        <option value="transfer">
                            🏦 Перевод
                        </option>

                    </select>

                    <div>

                        <div class="text-muted">
                            Итого
                        </div>

                        <strong id="total-sum">
                            0.00 ₴
                        </strong>

                    </div>

                    <button
                        id="saveInvoice"
                        class="btn btn-success btn-lg"
                        onclick="saveInvoice()">

                        <i class="bi bi-save"></i>

                        Сохранить чек

                    </button>
                </div>
            </div>
        </div>
        </div>
      </div>
    </div>
    <%- include('blocks/footer') -%>
  </body>
</html>