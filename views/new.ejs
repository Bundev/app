<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>
<div class="col content py-3">
<!-- ВЕРХНЯЯ ПАНЕЛЬ: Мультичеки в стиле нижних вкладок -->
    <div class="d-flex align-items-center justify-content-between border-bottom mb-4 bg-white p-2 pb-0">
        <!-- Добавлен класс custom-material-tabs -->
        <ul id="receipt-tabs" class="nav custom-material-tabs flex-grow-1 m-0">
            <!-- Заполняется динамически через JS -->
        </ul>
        <button type="button" id="add-receipt-btn" class="btn btn-primary btn-sm d-flex align-items-center gap-1 ms-3">
            <i class="bi bi-plus-lg fw-bold"></i><span>Новый чек</span>
        </button>
        <button type="button" id="held-receipts-btn" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1 ms-2" data-bs-toggle="modal" data-bs-target="#heldReceiptsModal">
            <i class="bi bi-archive"></i><span>Отложенные</span><span id="held-receipts-count" class="badge text-bg-secondary">0</span>
        </button>
    </div>
    <div class="d-flex justify-content-between align-items-center border-bottom mb-3">
        <ul class="nav nav-pills" id="pills-tab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-home-tab" data-bs-toggle="pill" data-bs-target="#pills-home" type="button" role="tab" aria-controls="pills-home" aria-selected="true">Основной</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="pills-profile-tab" data-bs-toggle="pill" data-bs-target="#pills-profile" type="button" role="tab" aria-controls="pills-profile" aria-selected="false">Товары</button>
            </li>
        </ul>
        
    </div>
    <div class="row g-4">
        
        <div class="col-xl-8 col-lg-7">
            <div class="tab-content" id="pills-tabContent">
                
                <div class="tab-pane fade" id="pills-home" role="tabpanel" aria-labelledby="pills-home-tab">
                    
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body p-3">
                            <div class="row">
                                <div class="col-md-12">
                                    <label class="form-label text-muted small fw-bold text-uppercase mb-2" title="[F3]">Покупатель / Клиент</label>
                                    
                                    <div class="input-group position-relative shadow-sm" style="border-radius: 6px;">
                                        <input type="hidden" id="customer_id" name="customer_id" value="">
                                        
                                        <input type="text" id="customer_name" class="form-control form-control-lg pe-5 fw-medium fs-6" autocomplete="off" value="Основной покупатель" title="F3" required style="border-right: none; border-radius: 6px 0 0 6px;">
                                        
                                        <div class="position-absolute d-flex gap-1 pe-2" style="z-index: 5; right: 55px; top: 50%; transform: translateY(-50%);">
                                            <button type="button" id="editCustomerBtn" class="btn p-1 text-primary border-0 bg-transparent" style="display: none;" title="Редактировать клиента">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button type="button" id="clearCustomerBtn" class="btn p-1 text-muted border-0 bg-transparent" style="display: none;">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>

                                        <div id="customerList" class="list-group position-absolute w-100 d-none shadow" style="z-index: 1050; max-height: 250px; overflow-y: auto; top: 100%; left: 0; border-radius: 0 0 6px 6px;"></div>
                                        
                                        <button type="button" class="btn btn-success px-3 d-flex align-items-center justify-content-center" data-bs-toggle="modal" data-bs-target="#addCustomerModal" title="Добавить клиента [F4]" style="border-radius: 0 6px 6px 0; border-left: none;">
                                            <i class="bi bi-plus-lg fs-5"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <label class="form-label text-muted small fw-bold text-uppercase mb-2">Комментарий к чеку</label>
                                    <textarea id="invoice_comment" class="form-control" rows="4" placeholder="Например: Доставка или особые условия..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade show active" id="pills-profile" role="tabpanel" aria-labelledby="pills-profile-tab">
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body p-3">
                            <div class="position-relative">
                                <label class="form-label text-muted small fw-bold text-uppercase mb-2" title="[F2]">Поиск или сканирование</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-white border-end-0 text-muted">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text" id="product-search" class="form-control border-start-0 ps-0" placeholder="Название, артикул или штрихкод...">
                                    <button type="button" id="scanBtn" class="btn btn-outline-primary d-md-none">
                                        <i class="bi bi-upc-scan"></i>
                                    </button>
                                </div>
                                
                                <div id="imagePreview"></div>
                                <div id="search-results" class="list-group position-absolute w-100 shadow" style="display:none; z-index:9999; max-height:300px; overflow-y:auto; top: 100%;"></div>
                            </div>
                        </div>
                    </div>  
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body p-0 d-flex flex-column">
                            <div id="receipt-items-scroll" class="table-responsive sales-table">
                                <table class="table table-sales align-middle mb-0">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th width="60" class="ps-3">№</th>
                                            <th>Товар</th>
                                            <th width="140">Кол-во</th>
                                            <th width="140">Цена</th>
                                            <th width="80" class="text-center pe-3">Действия</th>
                                        </tr>
                                    </thead>
                                    <tbody id="item-products"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>  
        </div>

        <div class="col-xl-4 col-lg-5">
            <div id="payment-panel" class="card border-0 shadow-sm sticky-top" style="top: 20px; z-index: 1020;">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h3 class="h5 fw-bold mb-0 text-muted text-uppercase small tracking-wider">Параметры оплаты</h3>
                </div>
                
                <div class="card-body px-4 pt-2 pb-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Способ расчета</label>
                        <select name="paymentMethod" id="payment-method"  class="form-select form-select-lg fw-medium" >
                            <option value="cash">💵 Наличные</option>
                            <option value="card">💳 Карта</option>
                            <option value="transfer">🏦 Перевод</option>
                        </select>
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-muted" title="[F8]">Получено</label>
                            <div class="input-group input-group-lg">
                                <input type="number" id="cash" class="form-control" min="0" placeholder="0.00" title="F8">
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-muted" title="[Ctrl+D]">Скидка %</label>
                            <div class="input-group input-group-lg">
                                <input type="number" id="discount" class="form-control" min="0" max="100" step="0.01" placeholder="0.00">
                            </div>
                        </div>
                    </div>
                    <div class="row g-2 mb-4">
                        
                        <div class="col-6">
                            <label class="form-label">📈 Наценка</label>
                            <input
                                type="number"
                                id="markup"
                                class="form-control"
                                value=""
                                min="0"
                                step="0.01"
                                placeholder="%"
                                oninput="applyMarkup()">
                        </div>
                        <div class="col-6">
                            <label class="form-label">💸 Сумма скидки</label>
                            <input
                                type="number"
                                id="discountAmount"
                                class="form-control"
                                min="0"
                                step="0.01"
                                placeholder="0.00">
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-header">ОСТАТКИ НА СКЛАДАХ</div>
                        <div class="card-body">
                            <h5 id="stock-panel-product-name" class="fw-bold">Товар не выбран</h5>
                            
                            <div id="stock-panel-qty" class="my-2">
                                Всего доступно: <span class="fw-bold text-success">0 шт</span>
                            </div>
                            
                            <div id="stock-panel-details" class="small text-muted">
                                В чеке нет товаров
                            </div>
                        </div>
                    </div>
                    <hr class="text-muted opacity-25 my-4">

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Подытог:</span>
                        <span class="fw-semibold" id="subtotal-sum">0.00 ₴</span>
                    </div>
                    
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Скидка (<span id="discount-label">0</span>%):</span>
                        <span class="text-danger fw-semibold" id="discount-sum">0.00 ₴</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Сдача:</span>
                        <span class="text-success fw-bold fs-5" id="change">0.00 ₴</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3 mb-4">
                        <span class="fw-bold text-secondary text-uppercase small">К оплате:</span>
                        <span class="text-primary fw-bolder fs-3" id="total-sum">0.00 ₴</span>
                    </div>

                    <button id="saveInvoice" class="btn btn-primary btn-lg w-100 py-3 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2" onclick="saveInvoice()">
                        <i class="bi bi-check2-circle fs-5"></i>
                        Провести чек
                    </button>
                    <button id="holdInvoice" type="button" class="btn btn-outline-secondary w-100 mt-2 py-2" onclick="holdInvoice()">
                        <i class="bi bi-archive me-1"></i>Отложить чек
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="heldReceiptsModal" tabindex="-1" aria-labelledby="heldReceiptsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title" id="heldReceiptsModalLabel"><i class="bi bi-archive me-2"></i>Отложенные чеки</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body p-0" id="held-receipts-list">
                <div class="p-4 text-center text-muted">Загрузка…</div>
            </div>
        </div>
    </div>
</div>

<div id="scannerModal">
    <div class="scanner-content">
        <div class="scanner-header">
            <span>📷 Сканирование товара</span>
            <button id="closeScanner" type="button">✕</button>
        </div>
        <div id="reader"></div>
        <div class="scanner-footer">Наведите камеру на штрихкод</div>
    </div>
</div>

<div class="modal fade" id="addCustomerModal" tabindex="-1" aria-labelledby="addCustomerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="addCustomerModalLabel">
                    <i class="bi bi-person-plus-fill me-2 text-success"></i>Добавить клиента
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <form id="addCustomerForm" onsubmit="createCustomer(event)">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="customerName" class="form-label small fw-semibold">Имя / Наименование <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-lg" id="customerName" placeholder="Иван Иванов" required autocomplete="off">
                    </div>
                    <div class="mb-3">
                        <label for="customerPhone" class="form-label small fw-semibold">Номер телефона</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                            <input type="tel" class="form-control" id="customerPhone" placeholder="+380983188450" autocomplete="off">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="customerEmail" class="form-label small fw-semibold">Электронная почта</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input type="email" class="form-control" id="customerEmail" placeholder="example@mail.com" autocomplete="off">
                        </div>
                    </div>
                    <div class="mb-0">
                        <label for="customerDiscount" class="form-label small fw-semibold">Персональная скидка (%)</label>
                        <div class="input-group">
                            <input type="number" class="form-control" id="customerDiscount" min="0" max="100" step="0.5" placeholder="0">
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-success px-4">Создать и выбрать</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editCustomerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold">Редактирование клиента</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editCustomerForm">
                <div class="modal-body p-4">
                    <input type="hidden" id="edit_customer_id">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Имя / Компания *</label>
                        <input type="text" id="edit_customer_name" class="form-control form-control-lg" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Телефон</label>
                        <input type="text" id="edit_customer_phone" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Email</label>
                        <input type="email" id="edit_customer_email" class="form-control">
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-semibold">Процент скидки (%)</label>
                        <input type="number" id="edit_customer_discount" class="form-control" step="0.01" min="0" max="100">
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary px-4">Сохранить изменения</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('blocks/footer') -%>
