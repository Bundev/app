<!doctype html>
<html lang="en">
  <head>
    <%- include('blocks/head') -%>
  </head>
  <body>
    <div id="overlay"></div>
    <%- include('blocks/header') -%>
    <div class="container-fluid" id="cont">
      <div class="row">
        <%- include('blocks/menu') -%>
        <div class="col content">
          <div class="d-flex justify-content-between align-items-center mb-3">

              <h2 class="mb-0">
                  🧾 Новый чек
                  <span class="badge bg-primary ms-2">
                      №<%= invoiceId %>
                  </span>
              </h2>

          </div>
          <div class="row mb-3">

            <div class="col-md-5">
                <select class="form-select" id="customer">
                  <option value="">Выберите покупателя</option>

                  <option value="Основной покупатель" selected>
                      Основной покупатель
                  </option>

                  <option value="Бунде Иван">
                      Бунде Иван
                  </option>

                  <option value="Бундев Вячеслав">
                      Бундев Вячеслав
                  </option>

                  <option value="Нотивский Иван">
                      Нотивский Иван
                  </option>
              </select>
            </div>

            <div class="col-md-3">
                <select
                    name="status"
                    id="status"
                    class="form-select">

                    <% Object.keys(statuses).forEach(key => { %>

                        <option
                            value="<%= key %>"
                            <%= (typeof invoice !== 'undefined'
                                ? invoice.status === key
                                : key === 'new')
                                ? 'selected'
                                : '' %>>

                            <%= statuses[key].title %>

                        </option>

                    <% }) %>

                </select>
            </div>

            <div class="col-md-2">
                <input
                    id="invoiceDate"
                    type="date"
                    class="form-control"
                    value="">
            </div>

            <div class="col-md-2">
                <button class="btn btn-success w-100">
                    + Клиент
                </button>
            </div>
        </div>
        <div class="input-group mb-3">
            
            <div class="searchbox flex-grow-1">
                <div class="position-relative">
                    <input class="form-control" id="search" type="text" placeholder="Введите название товара">
                    <button type="button" id="clearSearch" class="btn position-absolute top-50 end-0 translate-middle-y border-0 bg-transparent">✕</button>
                </div>

                <div id="searchresults">
                    <div id="producttop">
                        <div class="nomin"><b>Название товара</b></div>
                        <div class="price"><b>Цена</b></div>
                    </div>
                    <div id="results"></div>
                </div>
            </div>
        </div>
        

        

          
          





<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-container">
          <table class="table table-hover align-middle table-sales">

              <thead>
                  <tr>
                      <th style="width:60px">№</th>
                      <th>Название товара</th>
                      <th style="width:120px">Кол-во</th>
                      <th style="width:80px">Ед.</th>
                      <th style="width:120px">Цена</th>
                      <th style="width:120px">Сумма</th>
                      <th style="width:80px">Действие</th>
                  </tr>
              </thead>

              <tbody id="item-products">

              </tbody>

          </table>

</div>

    </div>

    <div class="card-footer bg-white">

        <div class="d-flex justify-content-end align-items-center gap-3">

            <div>
                <strong>Итого:</strong>
                <span id="total-sum">0.00</span> ₴
            </div>

            <input
                type="number"
                id="cash"
                class="form-control"
                style="width:140px"
                placeholder="Получено">

            <div>
                <strong id="change">0.00 ₴</strong>
            </div>

            <button
                id="saveInvoice"
                class="btn btn-primary" onclick="saveInvoice()">
                Сохранить
            </button>

        </div>

    </div>

</div>


        </div>
      </div>
    </div>
    <%- include('blocks/footer') -%>
  </body>
</html>