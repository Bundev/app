<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>CRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/main.css">
    <!-- Стили Select2 -->
<link href="https://jsdelivr.net" rel="stylesheet">
<!-- Дополнительный CSS-мост для адаптации Select2 под стили Bootstrap 5 -->
<link href="https://jsdelivr.net" rel="stylesheet">
  </head>
  <body>
    <%- include('blocks/header') -%>
    <div class="container-fluid" id="cont">
      <div class="row">
        <div class="col-2">
          <%- include('blocks/menu') -%>
        </div>
        <div class="col-10">
          <div class="input-group mb-3">
            <input class="form-control" id="search" type="text" placeholder="Введите название товара" aria-label="default input example">
            
          </div>
          <div class="container mt-5">
            <div class="mb-3">
                <select class="form-select" id="mySelect" name="state[]" multiple="multiple">
                    <option value="AL">Alabama</option>
                    <option value="WY">Wyoming</option>
                    <option value="WA">Washington</option>
                    <option value="VA">Virginia</option>
                </select>
            </div>
        </div>
    

<script>
const searchInput = document.getElementById('search');
const resultsDiv = document.getElementById('results');

let timer;

searchInput.addEventListener('input', () => {
  clearTimeout(timer);

  timer = setTimeout(async () => {
    const q = searchInput.value;

    if (q.length < 2) {
      resultsDiv.innerHTML = '';
      return;
    }

    const response = await fetch(
      `/search?q=${encodeURIComponent(q)}`
    );

    const products = await response.json();

    resultsDiv.innerHTML = products.map(product => `
      <div class="product">
        <b>${product.name}</b>
        Цена: ${product.price}
      </div>
    `).join('');
  }, 300);
});
</script>
          <table class="table">
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">Наминклатура</th>
                <th scope="col">Кол-во</th>
                <th scope="col">Ед.и</th>
                <th scope="col">Цена</th>
                <th scope="col">Сумма</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">1</th>
                <td>Прокладка для арматуры Siamp ЭКО Силикон ЗАВОД (2 КНОПКИ)</td>
                <td><input class="form-control" width="50px" type="text"  value="2" aria-label="default input example"></td>
                <td>Шт</td>
                <td>500</td>
                <td>1000</td>
              </tr>
            </tbody>
          </table>
          
        </div>
      </div>
    </div>
    <%- include('blocks/footer') -%>
    <!-- jQuery (требуется для Select2) -->
<script src="https://jsdelivr.net"></script>
<!-- Bootstrap 5 JS -->
<script src="https://jsdelivr.net"></script>
<!-- Select2 JS -->
<script src="https://jsdelivr.net"></script>

<script>
    $(document).ready(function() {
        $('#mySelect').select2({
            theme: 'bootstrap-5' // Применение темы Bootstrap 5
        });
    });
</script>

  </body>
</html>