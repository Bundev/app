<%- include('blocks/head') -%>

<main class="auth-page auth-page--register">
    <section class="auth-showcase" aria-label="<%= __('auth.aboutSystem') %>">
        <div class="auth-showcase__content">
            <a href="/login" class="auth-brand">
                <span class="auth-brand__mark"><i class="bi bi-shop-window"></i></span>
                <span><strong>RetailPro</strong><small>CRM</small></span>
            </a>
            <div class="auth-showcase__main">
                <span class="auth-eyebrow"><i class="bi bi-rocket-takeoff"></i> <%= __('auth.quickStart') %></span>
                <h1><%= __('auth.registerHeroTitle') %></h1>
                <p><%= __('auth.registerHeroDescription') %></p>
                <div class="auth-benefits">
                    <span><i class="bi bi-check2-circle"></i> <%= __('auth.setupBenefit') %></span>
                    <span><i class="bi bi-check2-circle"></i> <%= __('auth.teamBenefit') %></span>
                    <span><i class="bi bi-check2-circle"></i> <%= __('auth.securityBenefit') %></span>
                </div>
            </div>
            <small class="auth-showcase__footer">RetailPro CRM · <%= __('auth.managementSystem') %></small>
        </div>
    </section>

    <section class="auth-form-side">
        <div class="auth-language" aria-label="<%= __('auth.interfaceLanguage') %>">
            <a href="/lang/ru" class="<%= lang === 'ru' ? 'active' : '' %>">RU</a>
            <a href="/lang/uk" class="<%= lang === 'uk' ? 'active' : '' %>">UA</a>
        </div>
        <div class="auth-card auth-card--register">
            <div class="auth-mobile-brand">
                <span class="auth-brand__mark"><i class="bi bi-shop-window"></i></span>
                <strong>RetailPro</strong><small>CRM</small>
            </div>
            <header class="auth-card__header">
                <span class="auth-card__icon"><i class="bi bi-person-plus"></i></span>
                <h2><%= __('auth.createAccount') %></h2>
                <p><%= __('auth.registerSubtitle') %></p>
            </header>

            <% if (typeof error !== 'undefined' && error) { %>
            <div class="auth-alert auth-alert--danger" role="alert">
                <i class="bi bi-exclamation-circle-fill"></i><span><%= error %></span>
            </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
            <div class="auth-alert auth-alert--success" role="alert">
                <i class="bi bi-check-circle-fill"></i><span><%= success %></span>
            </div>
            <% } %>

            <form method="POST" action="/register" class="auth-form auth-form--register">
                <div class="auth-field auth-field--wide">
                    <label for="company_name"><i class="bi bi-building"></i> <%= __('auth.companyName') %></label>
                    <input id="company_name" type="text" name="company_name" class="form-control" maxlength="255" autocomplete="organization" placeholder="<%= __('auth.companyPlaceholder') %>" value="<%= formData && formData.companyName ? formData.companyName : '' %>" required>
                    <small class="auth-field__hint"><%= __('auth.companyHint') %></small>
                </div>
                <div class="auth-field auth-field--wide">
                    <label for="name"><i class="bi bi-person"></i> <%= __('auth.name') %></label>
                    <input id="name" type="text" name="name" class="form-control" autocomplete="name" placeholder="<%= __('auth.namePlaceholder') %>" value="<%= formData && formData.name ? formData.name : '' %>" required>
                </div>
                <div class="auth-field auth-field--wide">
                    <label for="email"><i class="bi bi-envelope"></i> <%= __('auth.email') %></label>
                    <input id="email" type="email" name="email" class="form-control" autocomplete="email" placeholder="name@example.com" value="<%= formData && formData.email ? formData.email : '' %>" required>
                </div>
                <div class="auth-field auth-field--wide">
                    <label for="login"><i class="bi bi-at"></i> <%= __('auth.login') %></label>
                    <input id="login" type="text" name="login" class="form-control" autocomplete="username" placeholder="<%= __('auth.createLoginPlaceholder') %>" value="<%= formData && formData.login ? formData.login : '' %>" required>
                </div>
                <div class="auth-field">
                    <label for="password"><i class="bi bi-lock"></i> <%= __('auth.password') %></label>
                    <input id="password" type="password" name="password" class="form-control" autocomplete="new-password" placeholder="<%= __('auth.passwordPlaceholder') %>" required>
                </div>
                <div class="auth-field">
                    <label for="password2"><i class="bi bi-shield-check"></i> <%= __('auth.repeatPassword') %></label>
                    <input id="password2" type="password" name="password2" class="form-control" autocomplete="new-password" placeholder="<%= __('auth.repeatPasswordPlaceholder') %>" required>
                </div>
                <button type="submit" class="btn auth-submit auth-field--wide"><%= __('auth.createAccountButton') %> <i class="bi bi-arrow-right"></i></button>
            </form>

            <div class="auth-switch"><%= __('auth.haveAccount') %> <a href="/login"><%= __('auth.signIn') %></a></div>
        </div>
    </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
