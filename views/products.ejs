<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>
<%
    const productRows = Array.isArray(products) ? products : [];
    const stockTotal = productRows.reduce(
        (total, product) => total + Number(product.quantity || 0),
        0
    );
    const lowStockCount = productRows.filter(
        product => Number(product.quantity || 0) > 0 && Number(product.quantity || 0) < 5
    ).length;
    const outOfStockCount = productRows.filter(
        product => Number(product.quantity || 0) <= 0
    ).length;
%>
<% if (importSuccess) { %>

<div
    class="position-fixed top-0 end-0 p-3"
    style="z-index:9999; width: 300px;"
    id="importSuccess">

    <div
        class="card border-success shadow">

        <div
            class="card-header bg-success text-white">

            <i class="bi bi-check-circle"></i>

            Импорт завершён

        </div>

        <div class="card-body">

            Категорий создано:
            <%= importSuccess.categoriesCreated %>

            <br>

            Товаров создано:
            <%= importSuccess.createdCount %>

            <br>

            Товаров обновлено:
            <%= importSuccess.updatedCount %>

            <br>

            Остатков обнулено:
            <%= importSuccess.zeroedStockCount || 0 %>

        </div>

    </div>

</div>

<% } %>
<% if (productSuccess) { %>

<div
    class="position-fixed top-0 end-0 p-3"
    style="z-index:9999; width: 300px"
    id="productSuccess">

    <div
        class="card border-primary shadow">

        <div
            class="card-header bg-primary text-white">

            <i class="bi bi-check-circle"></i>

            Товар обновлён

        </div>

        <div class="card-body">

            <%= productSuccess %>

        </div>

    </div>

</div>

<% } %>
<div id="scannerModal">

    <div class="scanner-content">

        <div class="scanner-header">
            <span class="scanner-title">
                <i class="bi bi-upc-scan"></i>
                <span>
                    <strong>Сканер штрихкода</strong>
                    <small>Камера активна</small>
                </span>
            </span>

            <button
                id="closeScanner"
                type="button"
                aria-label="Закрыть сканер">

                <i class="bi bi-x-lg"></i>
            </button>

        </div>

        <div class="scanner-viewport">
            <div id="reader"></div>
            <div class="scanner-target" aria-hidden="true">
                <span class="scanner-line"></span>
            </div>
        </div>

        <div class="scanner-footer">
            <i class="bi bi-bounding-box-circles"></i>
            <span>
                <strong>Поместите штрихкод в рамку</strong>
                <small>Держите камеру неподвижно — код считается автоматически</small>
            </span>

        </div>

    </div>

</div>
<div class="col content products-page">
    <div class="products-shell">

    <header class="products-header">
        <div>
            <div class="products-eyebrow"><i class="bi bi-box-seam"></i>Управление товарами</div>
            <h1>Склад</h1>
            <p>Товары, цены и актуальные остатки по магазинам</p>
        </div>

        <div class="products-actions">

            <a
                href="/products/add"
                class="products-primary-action" title="Добавить товар">

                <i class="bi bi-plus-lg"></i>
                <span>Добавить товар</span>

            </a>

            <a
                href="/products/import"
                class="products-secondary-action" title="Импортировать Excel">

                <i class="bi bi-file-earmark-excel"></i>
                <span>Импорт Excel</span>

            </a>

        </div>

    </header>

    <section class="products-metrics">
        <div class="products-metric">
            <span class="products-metric-icon products-metric-icon--primary"><i class="bi bi-boxes"></i></span>
            <span class="products-metric-copy"><span>Товаров</span><strong><%= productRows.length %></strong></span>
        </div>
        <div class="products-metric">
            <span class="products-metric-icon products-metric-icon--success"><i class="bi bi-stack"></i></span>
            <span class="products-metric-copy"><span>Единиц на складе</span><strong><%= stockTotal.toLocaleString(lang === 'uk' ? 'uk-UA' : 'ru-RU') %></strong></span>
        </div>
        <div class="products-metric">
            <span class="products-metric-icon products-metric-icon--warning"><i class="bi bi-exclamation-triangle"></i></span>
            <span class="products-metric-copy"><span>Заканчиваются</span><strong><%= lowStockCount %></strong></span>
        </div>
        <div class="products-metric">
            <span class="products-metric-icon products-metric-icon--danger"><i class="bi bi-x-circle"></i></span>
            <span class="products-metric-copy"><span>Нет в наличии</span><strong><%= outOfStockCount %></strong></span>
        </div>
    </section>

    <div class="products-list-card">

        <div class="card-body">

            <div class="products-toolbar">

                <div class="products-search">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input
                        type="search"
                        class="form-control"
                        id="search-product"
                        placeholder="Поиск по названию, артикулу или штрихкоду — клавиша /"
                        autocomplete="off">
                    <button
                        type="button"
                        class="products-qr-scan"
                        id="productsQrScan"
                        title="Сканировать QR-код или штрихкод"
                        aria-label="Сканировать QR-код или штрихкод">
                        <i class="bi bi-upc-scan" aria-hidden="true"></i>
                    </button>
                </div>

                <span
                    id="products-count"
                    class="products-count">

                    <%= products.length %>

                </span>

            </div>

            <div class="products-filters">
                <div class="products-category-filter">
                    <form method="GET" action="/products">
                        <label for="categoryId">
                            <i class="bi bi-funnel"></i>Категория
                        </label>
                        <select name="categoryId" id="categoryId" class="form-select" onchange="this.form.submit()">
                            <option value="all" <%= categoryId === 'all' ? 'selected' : '' %>>Все категорий (все)</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat.id %>" <%= String(categoryId) === String(cat.id) ? 'selected' : '' %>>
                                    <%= cat.name %>
                                </option>
                            <% }) %>
                        </select>
                    </form>
                </div>
            </div>
            <div class="table-responsive products-table-wrapper">

                <table class="table table-hover align-middle products-table">
                    <thead class="table-light">

                    <tr>

                        <th class="products-code-column">
                            Артикул
                        </th>
                        <th class="products-barcode-column">
                            Штрихкод
                        </th>

                        <th class="products-name-column">
                            Товар
                        </th>

                        <th class="products-price-column">
                            Цена
                        </th>

                        <th class="products-stock-column">
                            Остаток
                        </th>

                        <th class="products-actions-column">
                            Действия
                        </th>

                    </tr>

                    </thead>
                                    
                    <tbody id="products-table">

                    <% products.forEach(product => { %>

                    <tr
                        data-name="<%= product.name %>"
                        data-sku="<%= product.sku || '' %>"
                        data-barcode="<%= product.barcode || '' %>"
                        data-category="<%= product.category_name || '' %>">

                        <td
                            class="sku-cell"
                            data-id="<%= product.id %>"
                            data-sku="<%= product.sku || '' %>"
                            title="Нажмите, чтобы изменить артикул">

                            <button
                                type="button"
                                class="sku-value"
                                aria-label="Изменить артикул товара <%= product.name %>">

                                <code>
                                    <%= product.sku || 'Добавить' %>
                                </code>

                            </button>

                        </td>
                        <td class="barcode-cell text-center"
                        data-id="<%= product.id %>">

                            <code>
                               <% if (product.barcode) { %>

                                    <%= product.barcode %>

                                <% } else { %>

                                    Штрихкод

                                <% } %>
                            </code>

                        </td>

                        <td class="product-main-cell">

                            <div class="d-flex flex-column">

                                <button
                                    type="button"
                                    class="editable-value editable-text"
                                    data-id="<%= product.id %>"
                                    data-field="name"
                                    data-value="<%= product.name %>"
                                    data-unit="<%= product.unit %>"
                                    aria-label="Изменить название товара">

                                    <span class="fw-semibold product-name">
                                        <%= product.name %>, <%= product.unit%>
                                    </span>

                                </button>

                                <div class="mt-1">

                                    <button
                                        type="button"
                                        class="editable-value editable-category badge bg-light text-dark border"
                                        data-id="<%= product.id %>"
                                        data-field="category_id"
                                        data-value="<%= product.category_id || '' %>"
                                        aria-label="Изменить категорию товара">

                                        <%= product.category_name || 'Без категории' %>

                                    </button>

                                </div>

                            </div>

                        </td>

                        <td class="product-price-cell">

                            <button
                                type="button"
                                class="editable-value editable-number product-sale-price"
                                data-id="<%= product.id %>"
                                data-field="sale_price"
                                data-value="<%= product.sale_price %>"
                                aria-label="Изменить цену продажи">

                                <%= product.sale_price %> ₴

                            </button>

                            <button
                                type="button"
                                class="editable-value editable-number product-purchase-price"
                                data-id="<%= product.id %>"
                                data-field="purchase_price"
                                data-value="<%= product.purchase_price %>"
                                aria-label="Изменить закупочную цену">

                                Закупка:
                                <%= product.purchase_price %> ₴

                            </button>

                        </td>

                        <td class="product-stock-cell">

                            <button
                                type="button"
                                class="editable-value editable-number stock-value"
                                data-id="<%= product.id %>"
                                data-field="quantity"
                                data-value="<%= product.quantity %>"
                                aria-label="Изменить остаток">

                            <% if (product.quantity <= 0) { %>

                                <span class="product-stock product-stock--empty">

                                    Нет

                                </span>

                            <% } else if (product.quantity < 5) { %>

                                <span class="product-stock product-stock--low">

                                    <%= product.quantity %>

                                </span>

                            <% } else { %>

                                <span class="product-stock product-stock--available">

                                    <%= product.quantity %>

                                </span>

                            <% } %>

                            </button>

                        </td>

                        <td class="product-actions-cell">

                            <div class="product-row-actions">

                                <a
                                    href="/products/view/<%= product.id %>"
                                    class="product-row-action product-row-action--view"
                                    target="_blank"
                                    title="Просмотреть товар"
                                    aria-label="Просмотреть товар <%= product.name %>">
                                    <i class="bi bi-eye"></i>

                                </a>

                                <a
                                    href="/products/edit/<%= product.id %>"
                                    class="product-row-action"
                                    title="Редактировать товар"
                                    aria-label="Редактировать товар <%= product.name %>">
                                    <i class="bi bi-pencil"></i>

                                </a>
                                <a
                                    href="/products/label/<%= product.id %>"
                                    target="_blank"
                                    title="Открыть ценник"
                                    class="product-row-action"
                                    aria-label="Открыть ценник товара <%= product.name %>">
                                    <i class="bi bi-tag"></i>

                                </a>
                                <button
                                    type="button"
                                    class="product-row-action product-location-button"
                                    data-id="<%= product.id %>"
                                    data-name="<%= product.name %>"
                                    title="Местонахождение на складе"
                                    aria-label="Местонахождение товара <%= product.name %> на складе">
                                    <i class="bi bi-geo-alt"></i>
                                </button>
                                <a
                                    href="/products/archive/<%= product.id %>"
                                    class="product-row-action product-row-action--archive"
                                    title="Переместить в архив"
                                    aria-label="Переместить товар <%= product.name %> в архив"
                                    onclick="return confirm('Переместить товар в архив?')">
                                    <i class="bi bi-archive"></i>

                                </a>

                            </div>

                        </td>

                    </tr>

                    <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>
    </div>
</div>

<div class="modal fade" id="locationModal" tabindex="-1" aria-labelledby="locationModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="locationModalTitle">Местонахождение на складе</h5>
                    <small class="text-muted" id="locationProductName"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body" id="locationStoresList"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-primary" id="saveLocationButton">Сохранить</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="stockModal" tabindex="-1" aria-labelledby="stockModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="stockModalTitle">Изменить остаток</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3" id="stockProductName"></p>
                <div id="stockStoresList"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-primary" id="saveStockButton">Сохранить</button>
            </div>
        </div>
    </div>
</div>

<script>
    window.productCategories = <%- JSON.stringify(categories.map(category => ({
        id: category.id,
        name: category.name
    }))).replace(/</g, '\\u003c') %>;
</script>
<%- include('blocks/footer') -%>
