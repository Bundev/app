<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>
<% if (importSuccess) { %>

<div
    class="position-fixed top-0 end-0 p-3"
    style="z-index:9999; width: 300px;"
    id="importSuccess">

    <div
        class="card border-success shadow">

        <div
            class="card-header bg-success text-white">

            <i class="bi bi-check-circle"></i>

            Импорт завершён

        </div>

        <div class="card-body">

            Категорий создано:
            <%= importSuccess.categoriesCreated %>

            <br>

            Товаров создано:
            <%= importSuccess.createdCount %>

            <br>

            Товаров обновлено:
            <%= importSuccess.updatedCount %>

        </div>

    </div>

</div>

<% } %>
<% if (productSuccess) { %>

<div
    class="position-fixed top-0 end-0 p-3"
    style="z-index:9999; width: 300px"
    id="productSuccess">

    <div
        class="card border-primary shadow">

        <div
            class="card-header bg-primary text-white">

            <i class="bi bi-check-circle"></i>

            Товар обновлён

        </div>

        <div class="card-body">

            <%= productSuccess %>

        </div>

    </div>

</div>

<% } %>
<div id="scannerModal">

    <div class="scanner-content">

        <div class="scanner-header">

            <span>
                📷 Сканирование товара
            </span>

            <button
                id="closeScanner"
                type="button">

                ✕
            </button>

        </div>

        <div id="reader"></div>

        <div class="scanner-footer">

            Наведите камеру на штрихкод

        </div>

    </div>

</div>
<div class="col content">

    <div class="d-flex products-header justify-content-between align-items-center mb-4">

        <h2 class="products-title">
            📦 Склад
        </h2>

        <div class="d-flex gap-2 products-actions">

            <a
                href="/products/add"
                class="btn btn-primary" title="Добавить товар">

                <i class="bi bi-plus-lg"></i>
                

            </a>

            <a
                href="/products/import"
                class="btn btn-success" title="Импортировать Exlx">

                <i class="bi bi-file-earmark-excel"></i>
                

            </a>

        </div>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="d-flex justify-content-between mb-3">

                <input
                    type="text"
                    class="form-control"
                    id="search-product"
                    placeholder="🔍 Поиск по названию, артикулу, штрихкоду..."
                    oninput="filterProducts()">

                <span
                    id="products-count"
                    class="badge bg-primary align-self-center">

                    <%= products.length %>

                </span>

            </div>

            <div class="row mb-3 align-items-center g-2">
                <div class="col-md-4 col-sm-12">
                    <form method="GET" action="/products" class="d-flex align-items-center">
                        <label for="categoryId" class="me-2 fw-medium text-muted small text-uppercase text-nowrap">
                            <i class="bi bi-funnel me-1"></i>Категория:
                        </label>
                        <select name="categoryId" id="categoryId" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="all" <%= categoryId === 'all' ? 'selected' : '' %>>Все категорий (все)</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat.id %>" <%= String(categoryId) === String(cat.id) ? 'selected' : '' %>>
                                    <%= cat.name %>
                                </option>
                            <% }) %>
                        </select>
                    </form>
                </div>
            </div>
            <div class="table-responsive products-table-wrapper">

                <table class="table table-hover align-middle">
                    <thead class="table-light">

                    <tr>

                        <th width="120">
                            Артикул
                        </th>
                        <th width="120">
                            Штрихкод
                        </th>

                        <th>
                            Товар
                        </th>

                        <th width="120">
                            Цена
                        </th>

                        <th width="100">
                            Остаток
                        </th>

                        <th width="120">
                            Действия
                        </th>

                    </tr>

                    </thead>
                                    
                    <tbody id="products-table">

                    <% products.forEach(product => { %>

                    <tr
                        data-name="<%= product.name %>"
                        data-sku="<%= product.sku || '' %>"
                        data-barcode="<%= product.barcode || '' %>"
                        data-category="<%= product.category_name || '' %>">

                        <td
                            class="sku-cell"
                            data-id="<%= product.id %>"
                            data-sku="<%= product.sku || '' %>"
                            title="Нажмите, чтобы изменить артикул">

                            <button
                                type="button"
                                class="sku-value"
                                aria-label="Изменить артикул товара <%= product.name %>">

                                <code>
                                    <%= product.sku || 'Добавить' %>
                                </code>

                            </button>

                        </td>
                        <td class="barcode-cell text-center"
                        data-id="<%= product.id %>">

                            <code>
                               <% if (product.barcode) { %>

                                    <%= product.barcode %>

                                <% } else { %>

                                    Штрихкод

                                <% } %>
                            </code>

                        </td>

                        <td>

                            <div class="d-flex flex-column">

                                <button
                                    type="button"
                                    class="editable-value editable-text"
                                    data-id="<%= product.id %>"
                                    data-field="name"
                                    data-value="<%= product.name %>"
                                    data-unit="<%= product.unit %>"
                                    aria-label="Изменить название товара">

                                    <span class="fw-semibold product-name">
                                        <%= product.name %>, <%= product.unit%>
                                    </span>

                                </button>

                                <div class="mt-1">

                                    <button
                                        type="button"
                                        class="editable-value editable-category badge bg-light text-dark border"
                                        data-id="<%= product.id %>"
                                        data-field="category_id"
                                        data-value="<%= product.category_id || '' %>"
                                        aria-label="Изменить категорию товара">

                                        <%= product.category_name || 'Без категории' %>

                                    </button>

                                </div>

                            </div>

                        </td>

                        <td>

                            <button
                                type="button"
                                class="editable-value editable-number fw-bold text-success"
                                data-id="<%= product.id %>"
                                data-field="sale_price"
                                data-value="<%= product.sale_price %>"
                                aria-label="Изменить цену продажи">

                                <%= product.sale_price %> ₴

                            </button>

                            <button
                                type="button"
                                class="editable-value editable-number small text-muted"
                                data-id="<%= product.id %>"
                                data-field="purchase_price"
                                data-value="<%= product.purchase_price %>"
                                aria-label="Изменить закупочную цену">

                                Закупка:
                                <%= product.purchase_price %> ₴

                            </button>

                        </td>

                        <td>

                            <button
                                type="button"
                                class="editable-value editable-number stock-value"
                                data-id="<%= product.id %>"
                                data-field="quantity"
                                data-value="<%= product.quantity %>"
                                aria-label="Изменить остаток">

                            <% if (product.quantity <= 0) { %>

                                <span class="badge bg-danger">

                                    Нет

                                </span>

                            <% } else if (product.quantity < 5) { %>

                                <span class="badge bg-warning text-dark">

                                    <%= product.quantity %>

                                </span>

                            <% } else { %>

                                <span class="badge bg-success">

                                    <%= product.quantity %>

                                </span>

                            <% } %>

                            </button>

                        </td>

                        <td>

                            <div class="btn-group">

                                <a
                                    href="/products/view/<%= product.id %>"
                                    class="btn btn-outline-primary" target="_blank">

                                    👁

                                </a>

                                <a
                                    href="/products/edit/<%= product.id %>"
                                    class="btn btn-outline-secondary" >

                                    ✏️

                                </a>
                                <a
                                    href="/products/label/<%= product.id %>"
                                    target="_blank" title="Ценник"
                                    class="btn btn-sm btn-outline-secondary" target="_blank">

                                    🏷 

                                </a>
                                <a
                                    href="/products/archive/<%= product.id %>"
                                    class="btn btn-outline-warning"
                                    onclick="return confirm('Переместить товар в архив?')">

                                    📦

                                </a>

                            </div>

                        </td>

                    </tr>

                    <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>
</div>

<div class="modal fade" id="stockModal" tabindex="-1" aria-labelledby="stockModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="stockModalTitle">Изменить остаток</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3" id="stockProductName"></p>
                <div id="stockStoresList"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-primary" id="saveStockButton">Сохранить</button>
            </div>
        </div>
    </div>
</div>

<script>
    window.productCategories = <%- JSON.stringify(categories.map(category => ({
        id: category.id,
        name: category.name
    }))).replace(/</g, '\\u003c') %>;
</script>
<%- include('blocks/footer') -%>
