<!doctype html>
<html lang="en">
  <head>
   <%- include('blocks/head') -%>
  </head>
  <body>
<% if (importSuccess) { %>

<div
    class="position-fixed top-0 end-0 p-3"
    style="z-index:9999"
    id="importSuccess">

    <div
        class="card border-success shadow">

        <div
            class="card-header bg-success text-white">

            <i class="bi bi-check-circle"></i>

            Импорт завершён

        </div>

        <div class="card-body">

            Категорий создано:
            <%= importSuccess.categoriesCreated %>

            <br>

            Товаров создано:
            <%= importSuccess.createdCount %>

            <br>

            Товаров обновлено:
            <%= importSuccess.updatedCount %>

        </div>

    </div>

</div>

<% } %>
<% if (productSuccess) { %>

<div
    class="position-fixed top-0 end-0 p-3"
    style="z-index:9999"
    id="productSuccess">

    <div
        class="card border-primary shadow">

        <div
            class="card-header bg-primary text-white">

            <i class="bi bi-check-circle"></i>

            Товар обновлён

        </div>

        <div class="card-body">

            <%= productSuccess %>

        </div>

    </div>

</div>

<% } %>

<div id="scannerModal">

    <div class="scanner-content">

        <div class="scanner-header">

            <span>
                📷 Сканирование товара
            </span>

            <button
                id="closeScanner"
                type="button">

                ✕
            </button>

        </div>

        <div id="reader"></div>

        <div class="scanner-footer">

            Наведите камеру на штрихкод

        </div>

    </div>

</div>

</div>
    <div id="overlay"></div>
    <%- include('blocks/header') -%>
    <div class="container-fluid" id="cont">
      <div class="row">
        <%- include('blocks/menu') -%>
        <div class="col content">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h2>
                📦 Товары
            </h2>
            
<div class="d-flex gap-2">

    <a
        href="/products/new"
        class="btn btn-primary">

        <i class="bi bi-plus-lg"></i>
        Добавить товар

    </a>

    <a
        href="/products/import"
        class="btn btn-success">

        <i class="bi bi-file-earmark-excel"></i>
        Импорт Excel

    </a>

</div>

        </div>


<div class="card shadow-sm border-0">

    <div class="card-body">

        <div class="d-flex justify-content-between mb-3">

            <input
    type="text"
    class="form-control"
    id="search-product"
    placeholder="🔍 Поиск по названию, артикулу, штрихкоду..."
    oninput="filterProducts()">

            <span
                id="products-count"
                class="badge bg-primary align-self-center">

                <%= products.length %>

            </span>

        </div>

        <div class="table-responsive products-table-wrapper">

            <table class="table table-hover align-middle">
<thead class="table-light">

<tr>

    <th width="120">
        Артикул
    </th>
    <th width="120">
        Штрихкод
    </th>

    <th>
        Товар
    </th>

    <th width="120">
        Цена
    </th>

    <th width="100">
        Остаток
    </th>

    <th width="120">
        Действия
    </th>

</tr>

</thead>
                
<tbody id="products-table">

<% products.forEach(product => { %>

<tr
    data-name="<%= product.name %>"
    data-sku="<%= product.sku || '' %>"
    data-barcode="<%= product.barcode || '' %>"
    data-category="<%= product.category_name || '' %>">

    <td >

        <code>
            <%= product.sku || '-' %>
        </code>

    </td>
    <td class="barcode-cell"
    data-id="<%= product.id %>">

        <code>
            <%= product.barcode || 'Сканировать' %>
        </code>

    </td>

    <td>

        <div class="d-flex flex-column">

            <span class="fw-semibold product-name">

                <%= product.name %>

            </span>

            <div class="mt-1">

                <span class="badge bg-light text-dark border">

                    <%= product.category_name || 'Без категории' %>

                </span>

            </div>

        </div>

    </td>

    <td>

        <div class="fw-bold text-success">

            <%= product.sale_price %> ₴

        </div>

        <small class="text-muted">

            Закупка:
            <%= product.purchase_price %> ₴

        </small>

    </td>

    <td>

        <% if (product.quantity <= 0) { %>

            <span class="badge bg-danger">

                Нет

            </span>

        <% } else if (product.quantity < 5) { %>

            <span class="badge bg-warning text-dark">

                <%= product.quantity %>

            </span>

        <% } else { %>

            <span class="badge bg-success">

                <%= product.quantity %>

            </span>

        <% } %>

    </td>

    <td>

        <div class="btn-group btn-group-sm">

            <a
                href="/products/view/<%= product.id %>"
                class="btn btn-outline-primary">

                👁

            </a>

            <a
                href="/products/edit/<%= product.id %>"
                class="btn btn-outline-secondary">

                ✏️

            </a>
            <a
    href="/products/label/<%= product.id %>"
    target="_blank" title="Ценник"
    class="btn btn-sm btn-outline-secondary">

    🏷 

</a>

        </div>

    </td>

</tr>

<% }) %>

</tbody>

            </table>

        </div>

    </div>

</div>



        



        </div>
      </div>
    </div>
    <%- include('blocks/footer') -%>
    <script src="https://unpkg.com/html5-qrcode"></script>
    <script>
        // Обновлени штрихкода

document
    .querySelectorAll('.barcode-cell')
    .forEach(cell => {

        cell.addEventListener(
            'dblclick',
            () => {

                currentProductId =
                    cell.dataset.id;

                document
                    .getElementById(
                        'scannerModal'
                    )
                    .style.display =
                    'flex';

                startBarcodeScanner();

            }
        );

    });

let currentProductId = null;
let scanner = null;

function startBarcodeScanner() {

    scanner =
        new Html5Qrcode(
            'reader'
        );

    scanner.start(
        {
            facingMode:
                'environment'
        },
        {
            fps: 10,
            qrbox: 250
        },
        async (barcode) => {

            await saveBarcode(
                currentProductId,
                barcode
            );

        }
    );

}
async function saveBarcode(
    productId,
    barcode
) {

    const response =
        await fetch(
            `/products/barcode/${productId}`,
            {
                method: 'POST',

                headers: {
                    'Content-Type':
                        'application/json'
                },

                body: JSON.stringify({
                    barcode
                })
            }
        );

    const result =
        await response.json();

    if (result.success) {

        const cell =
            document.querySelector(
                `.barcode-cell[data-id="${productId}"]`
            );

        cell.textContent =
            barcode;

        await scanner.stop();

        document
            .getElementById(
                'scannerModal'
            )
            .style.display =
            'none';

    }

}
document
    .getElementById(
        'closeScanner'
    )
    .addEventListener(
        'click',
        async () => {

            if (scanner) {

                try {

                    await scanner.stop();

                } catch (e) {}

            }

            document
                .getElementById(
                    'scannerModal'
                )
                .style.display =
                'none';

        }
    );
    </script>
  </body>
</html>