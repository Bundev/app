<!doctype html>
<html lang="en">
  <head>
    <%- include('blocks/head') -%>
  </head>
  <body>
    <div id="overlay"></div>
    <%- include('blocks/header') -%>
    <div class="container-fluid" id="cont">
      <div class="row">
        <%- include('blocks/menu') -%>
        <div class="col content">
<div class="card shadow-sm border-0">

    <div class="card-body">

        <div class="row">

            <div class="col-md-3 text-center">

                <img
                    src="<%= user.avatar %>"
                    class="rounded-circle border"
                    width="140">

                <h4 class="mt-3">

                    <%= user.name %>

                </h4>

                <span class="badge bg-primary">

                    <%= user.role %>

                </span>

            </div>

            <div class="col-md-9">

                <table class="table">

                    <tr>

                        <th>Логин</th>

                        <td>
                            <%= user.login %>
                        </td>

                    </tr>

                    <tr>

                        <th>Email</th>

                        <td>
                            <%= user.email %>
                        </td>

                    </tr>

                    <tr>

                        <th>Телефон</th>

                        <td>
                            <%= user.phone || '-' %>
                        </td>

                    </tr>

                    <tr>

                        <th>Должность</th>

                        <td>
                            <%= user.position || '-' %>
                        </td>

                    </tr>

                    <tr>

                        <th>Зарплата</th>

                        <td>
                            <%= user.salary || 0 %> ₴
                        </td>

                    </tr>

                </table>

            </div>

        </div>

    </div>

</div>

<div class="card mt-3">

    <div class="card-header">

        🏪 Назначенные магазины

    </div>

    <div class="card-body">

        <% stores.forEach(store => { %>

            <span class="badge bg-success me-2">

                <%= store.name %>

            </span>

        <% }) %>

    </div>

</div>
<div class="mt-3">

    <a
        href="/users/edit/<%= user.id %>"
        class="btn btn-primary">

        ✏️ Редактировать

    </a>

    <a
        href="/users/stores/<%= user.id %>"
        class="btn btn-info">

        🏪 Магазины

    </a>

    <a
        href="/users/block/<%= user.id %>"
        class="btn btn-warning">

        🔒 Заблокировать

    </a>

    <a
        href="/users/delete/<%= user.id %>"
        class="btn btn-danger">

        🗑 Удалить

    </a>

</div>

        </div>
      </div>
    </div>
    <%- include('blocks/footer') -%>
  </body>
</html>