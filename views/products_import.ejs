<!doctype html>
<html lang="en">
  <head>
    <%- include('blocks/head') -%>
  </head>
  <body>
    <div id="overlay"></div>
    <%- include('blocks/header') -%>
    <div class="container-fluid" id="cont">
      <div class="row">
        <%- include('blocks/menu') -%>
        <div class="col content">

<div class="card shadow-sm">

    <div class="card-header">

        Импорт товаров из Excel

    </div>

    <div class="card-body">

        <form
            action="/products/import"
            method="POST"
            enctype="multipart/form-data">

            <div class="mb-3">

                <label class="form-label">

                    Магазин

                </label>

                <select
                    name="store_id"
                    class="form-select">

                    <% stores.forEach(store => { %>

                        <option value="<%= store.id %>">

                            <%= store.name %>

                        </option>

                    <% }) %>

                </select>

            </div>

            <div class="mb-3">

                <label class="form-label">

                    Excel файл

                </label>

                <input
                    type="file"
                    name="excel"
                    accept=".xlsx,.xls"
                    class="form-control"
                    required>

            </div>

            <button
                type="submit"
                class="btn btn-success">

                <i class="bi bi-upload"></i>
                Начать импорт

            </button>

        </form>

    </div>

</div>

        </div>
      </div>
    </div>
    <%- include('blocks/footer') -%>
  </body>
</html>