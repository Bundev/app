
<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>
<div class="col content">

    <h2>

        Возврат по чеку
        <%= sale.invoice_number %>

    </h2>

    <form
        method="post"
        action="/sale/<%= sale.id %>/return">
    <table class="table">

    <thead>

    <tr>

        <th>Товар</th>

        <th>Продано</th>

        <th>Возвращено</th>

        <th>Доступно</th>

        <th>Вернуть</th>

    </tr>

    </thead>

    <tbody>

    <% items.forEach(item => { %>

    <tr>

        <td>
            <%= item.name %>
        </td>

        <td>
            <%= item.quantity %>
        </td>

        <td>
            <%= item.returned_qty %>
        </td>

        <td>
            <%= item.quantity - item.returned_qty %>
        </td>

        <td>

            <input
                type="number"
                min="0"
                max="<%= item.quantity - item.returned_qty %>"
                value="0"
                class="form-control"
                name="return_<%= item.id %>">

        </td>

    </tr>

    <% }) %>

    </tbody>

    </table>
    <button
        class="btn btn-danger">

        Оформить возврат

    </button>

    </form>
</div>



<%- include('blocks/footer') -%>
