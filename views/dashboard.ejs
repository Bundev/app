<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>

<%
    const popularProducts = Array.isArray(topProducts) ? topProducts : [];
    const recentInvoices = Array.isArray(invoices) ? invoices : [];
    const maxQty = popularProducts.length
        ? Math.max(...popularProducts.map(item => Number(item.total_qty || 0)), 1)
        : 1;
%>

<div class="col content dashboard-page">
    <div class="dashboard-shell">
        <header class="dashboard-header">
            <div>
                <div class="dashboard-eyebrow">
                    <i class="bi bi-grid-1x2"></i>Рабочая сводка
                </div>
                <h1><%= __('title.dashboard') %></h1>
                <p>Продажи, возвраты и ключевые показатели за сегодня</p>
            </div>
            <a href="/sales/new" class="dashboard-primary-action">
                <i class="bi bi-plus-lg"></i>Новый чек
            </a>
        </header>

        <section class="dashboard-metrics">
            <article class="dashboard-metric">
                <span class="dashboard-metric-icon dashboard-metric-icon--primary">
                    <i class="bi bi-cart-check"></i>
                </span>
                <span class="dashboard-metric-copy">
                    <span>Продажи сегодня</span>
                    <strong><%= grossSalesToday.toLocaleString('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> ₴</strong>
                    <small><%= invoicesToday %> чеков</small>
                </span>
            </article>

            <article class="dashboard-metric">
                <span class="dashboard-metric-icon dashboard-metric-icon--danger">
                    <i class="bi bi-arrow-return-left"></i>
                </span>
                <span class="dashboard-metric-copy">
                    <span>Возвраты сегодня</span>
                    <strong><%= returnsToday.toLocaleString('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> ₴</strong>
                    <small>Возвращено покупателям</small>
                </span>
            </article>

            <article class="dashboard-metric">
                <span class="dashboard-metric-icon dashboard-metric-icon--success">
                    <i class="bi bi-cash-stack"></i>
                </span>
                <span class="dashboard-metric-copy">
                    <span>Чистая выручка</span>
                    <strong><%= salesToday.toLocaleString('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> ₴</strong>
                    <small>После возвратов</small>
                </span>
            </article>

            <article class="dashboard-metric">
                <span class="dashboard-metric-icon dashboard-metric-icon--warning">
                    <i class="bi bi-graph-up-arrow"></i>
                </span>
                <span class="dashboard-metric-copy">
                    <% if (user.role === 'admin') { %>
                        <span>Маржа сегодня</span>
                        <strong><%= todayMargin.toLocaleString('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> ₴</strong>
                        <small>Расчётная прибыль</small>
                    <% } else { %>
                        <span>Чеков сегодня</span>
                        <strong><%= invoicesToday %></strong>
                        <small>Проведённых операций</small>
                    <% } %>
                </span>
            </article>
        </section>

        <section class="dashboard-secondary-metrics">
            <div class="dashboard-secondary-metric">
                <i class="bi bi-people"></i>
                <span><small>Активных клиентов</small><strong><%= clientsCount %></strong></span>
                <i class="bi bi-people-fill"></i>
            </div>
            <a href="/sales" class="dashboard-secondary-metric">
                <i class="bi bi-box-seam"></i>
                <span><small>Продано товаров сегодня</small><strong><%= productsToday %></strong></span>
                <i class="bi bi-arrow-right"></i>
            </a>
            <a href="/sales" class="dashboard-secondary-metric">
                <i class="bi bi-clock-history"></i>
                <span><small>Последних чеков</small><strong><%= recentInvoices.length %></strong></span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </section>

        <div class="dashboard-grid">
            <section class="dashboard-card dashboard-products-card">
                <div class="dashboard-card-heading">
                    <div>
                        <h2>Популярные товары</h2>
                        <p>Лидеры продаж за последние 7 дней</p>
                    </div>
                    <span class="dashboard-card-icon"><i class="bi bi-fire"></i></span>
                </div>

                <div class="dashboard-products-list">
                    <% if (!popularProducts.length) { %>
                        <div class="dashboard-empty">
                            <i class="bi bi-bar-chart"></i>
                            <strong>Пока недостаточно данных</strong>
                            <span>Проданные товары появятся здесь автоматически</span>
                        </div>
                    <% } %>

                    <% popularProducts.forEach((item, index) => { %>
                        <div class="dashboard-product">
                            <span class="dashboard-product-rank"><%= index + 1 %></span>
                            <div class="dashboard-product-main">
                                <div class="dashboard-product-line">
                                    <strong><%= item.name %></strong>
                                    <span><%= item.total_qty %> <%= item.unit %></span>
                                </div>
                                <div class="dashboard-product-progress">
                                    <span style="width: <%= Math.min(100, Number(item.total_qty || 0) / maxQty * 100) %>%"></span>
                                </div>
                                <small>Продажи: <%= Number(item.total_sales).toLocaleString('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> ₴</small>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </section>

            <aside class="dashboard-card dashboard-actions-card">
                <div class="dashboard-card-heading">
                    <div>
                        <h2><%= __('dashboard.quickActions') %></h2>
                        <p>Основные разделы системы</p>
                    </div>
                    <span class="dashboard-card-icon"><i class="bi bi-lightning-charge"></i></span>
                </div>
                <div class="dashboard-actions-list">
                    <a href="/sales/new" class="dashboard-action dashboard-action--primary">
                        <i class="bi bi-receipt"></i><span><strong>Новый чек</strong><small>Оформить продажу</small></span><i class="bi bi-chevron-right"></i>
                    </a>
                    <% if (user && user.role === 'admin') { %>
                        <a href="/products" class="dashboard-action">
                            <i class="bi bi-boxes"></i><span><strong>Склад</strong><small>Товары и остатки</small></span><i class="bi bi-chevron-right"></i>
                        </a>
                        <a href="/customers" class="dashboard-action">
                            <i class="bi bi-people"></i><span><strong>Клиенты</strong><small>Клиентская база</small></span><i class="bi bi-chevron-right"></i>
                        </a>
                        <a href="/finance/cash" class="dashboard-action">
                            <i class="bi bi-wallet2"></i><span><strong>Касса</strong><small>Движение средств</small></span><i class="bi bi-chevron-right"></i>
                        </a>
                    <% } %>
                </div>
            </aside>
        </div>
    </div>
</div>

<%- include('blocks/footer') -%>
