<!doctype html>
<html lang="en">
    <head>
        <%- include('blocks/head') -%>
    </head>
    <body>
        <%- include('blocks/header') -%>
        <div class="container-fluid" id="cont">
            <div class="row">
                <div class="col-2">
                    <%- include('blocks/menu') -%>
                </div>
                <div class="col-10" >
                    <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2>
                        📊 <%= __('title.dashboard') %>
                    </h2>
                </div>

    <div class="row g-3 mb-4">

        <div class="col-md-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="text-muted">
                        <%= __('salesTodayTitle') %>
                    </div>

                    <h3 class="mt-2">
                        <%= salesToday.toFixed(2) %> ₴
                    </h3>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="text-muted">
                        <%= __('invoicesTodayTitle') %>
                    </div>

                    <h3 class="mt-2">
                        <%= invoicesToday %>
                    </h3>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="text-muted">
                        <%= __('productsTitle') %>
                    </div>

                    <h3 class="mt-2">
                        <%= productsCount %>
                    </h3>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="text-muted">
                        <%= __('customersTitle') %>
                    </div>

                    <h3 class="mt-2">
                        <%= clientsCount %>
                    </h3>

                </div>

            </div>

        </div>

    </div>

    <div class="row g-3">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white">

                    Последние чеки

                </div>
                

                    
                <div class="card-body p-0">
                    <div class="table-scroll">
                        <table class="table table-hover align-middle mb-0">

                            <thead>

                                <tr>
                                    <th>№</th>
                                    <th>Клиент</th>
                                    <th>Сумма</th>
                                    <th>Статус</th>
                                </tr>

                            </thead>

                            <tbody>

                                <% invoices.forEach(invoice => { %>

                                <tr class="invoice-row-dashboard" data-url="/invoices/<%= invoice.number %>">

                                    <td>
                                        <span class="badge bg-light text-primary border">
                                            №<%= invoice.number %>
                                        </span>
                                    </td>

                                    <td><%= invoice.customer %></td>

                                    <td>
                                        <%= Number(invoice.total).toFixed(2) %> ₴
                                    </td>
                                    <td>
<% if (invoice.status === 'new') { %>

<span class="badge bg-primary">
    Новый
</span>

<% } else if (invoice.status === 'processing') { %>

<span class="badge bg-warning text-dark">
    В обработке
</span>

<% } else if (invoice.status === 'packing') { %>

<span class="badge bg-orange">
    Собирается
</span>

<% } else if (invoice.status === 'ready') { %>

<span class="badge bg-purple">
    Готов к выдаче
</span>

<% } else if (invoice.status === 'delivery') { %>

<span class="badge bg-info">
    Доставляется
</span>

<% } else if (invoice.status === 'completed') { %>

<span class="badge bg-success">
    Выполнен
</span>

<% } else if (invoice.status === 'cancelled') { %>

<span class="badge bg-danger">
    Отменён
</span>

<% } %>


                                    </td>

                                </tr>

                                <% }) %>

                            </tbody>

                        </table>
                    </div>
                </div>
                
            </div>

        </div>

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white">

                    <%= __('quickActions') %>

                </div>

                <div class="card-body">

                    <div class="d-grid gap-2">

                        <a href="/new/<%= nextInvoiceNumber %>"
                           class="btn btn-primary">

                            🧾 Новый чек

                        </a>

                        <a href="/products"
                           class="btn btn-outline-secondary">

                            📦 Товары

                        </a>

                        <!-- <a href="/clients"
                           class="btn btn-outline-secondary">

                            👥 Клиенты

                        </a>

                        <a href="/finance/cash"
                           class="btn btn-outline-secondary">

                            💰 Касса

                        </a> -->

                    </div>

                </div>

            </div>
                </div>
            </div>
            </div>
        </div>
        <%- include('blocks/footer') -%>
    </body>
</html>