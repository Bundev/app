<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>
<div class="col content">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
        <h2>📊 <%= __('title.dashboard') %></h2>
    </div>
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="text-muted">
                        Продажи сегодня
                    </div>

                    <h3 class="mt-2">
                        <%= grossSalesToday.toFixed(2) %> ₴
                    </h3>

                </div>

            </div>

        </div>

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="text-muted">
                        Возвраты сегодня
                    </div>

                    <h3 class="mt-2">
                        <%= returnsToday.toFixed(2) %> ₴
                    </h3>

                </div>

            </div>

        </div>

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="text-muted">
                        Доход сегодня
                    </div>

                    <h3 class="mt-2">
                        <%= salesToday.toFixed(2) %> ₴
                    </h3>

                </div>

            </div>

        </div>

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <% if (user.role === 'admin') { %>

                        <div class="text-muted">
                            Маржа за сегодня
                        </div>

                        <h3 class="mt-2 text-success">
                            <%= todayMargin.toFixed(2) %> ₴
                        </h3>

                    <% } else { %>

                        <div class="text-muted">
                            Чеков за сегодня
                        </div>

                        <h3 class="mt-2">
                            <%= invoicesToday %>
                        </h3>

                    <% } %>

                </div>

            </div>

        </div>
    </div>
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white fw-bold">

                    🔥 Самые продаваемые товары
                    <span class="text-muted">
                        (7 дней)
                    </span>

                </div>

                <div class="card-body top-products-body">

                    <% const maxQty =
                        topProducts.length
                            ? topProducts[0].total_qty
                            : 1;
                    %>

                    <% topProducts.forEach(item => { %>

                        <div class="mb-3">

                            <div class="d-flex justify-content-between">

                                <div>

                                    <strong>
                                        <%= item.name %>
                                    </strong>

                                </div>

                                <div>

                                    <span
                                        class="badge bg-primary">

                                        <%= item.total_qty %> <%= item.unit %>

                                    </span>

                                </div>

                            </div>

                            <div
                                class="progress mt-2"
                                style="height:8px;">

                                <div
                                    class="progress-bar"

                                    style="
                                        width:
                                        <%= (item.total_qty / maxQty) * 100 %>%;
                                    ">
                                </div>

                            </div>

                            <small class="text-muted">

                                Продажи:
                                <%= Number(item.total_sales)
                                    .toFixed(2) %> ₴

                            </small>

                        </div>

                    <% }) %>

                </div>

            </div>


        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <%= __('dashboard.quickActions') %>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/sales/new"
                        class="btn btn-primary">

                            🧾 Новый чек

                        </a>
                        <% if (user && user.role === 'admin') { %>
                        <a href="/products"
                        class="btn btn-outline-secondary">

                            📦 Склад

                        </a>

                        <a href="/customers"
                        class="btn btn-outline-secondary">

                            👥 Клиенты

                        </a>

                        <a href="/finance/cash"
                        class="btn btn-outline-secondary">

                            💰 Касса

                        </a>
                        <%}%>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('blocks/footer') -%>