<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>
<div class="col content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800 fw-bold">🛒 Журнал закупок</h1>
        <a href="/purchases/add" class="btn btn-primary btn-sm px-3 py-2 rounded-2 shadow-sm fw-medium">
            <i class="bi bi-file-earmark-plus me-1"></i> Создать закупку
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom text-secondary text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                        <tr>
                            <th class="ps-4 py-3 fw-bold" style="width: 130px;">Дата</th>
                            <th class="py-3 fw-bold">Накладная</th>
                            <th class="py-3 fw-bold">Поставщик</th>
                            <th class="py-3 fw-bold">Склад поступления</th>
                            <th class="py-3 fw-bold text-end" style="width: 150px;">Сумма</th>
                            <th class="py-3 fw-bold text-center" style="width: 140px;">Статус</th>
                            <th class="pe-4 py-3 fw-bold text-end" style="width: 100px;">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (purchases.length === 0) { %>
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted opacity-25 mb-3">
                                        <i class="bi bi-receipt" style="font-size: 3.5rem;"></i>
                                    </div>
                                    <h5 class="text-secondary fw-semibold mb-1">Накладных еще нет</h5>
                                    <p class="text-muted small mb-0">Создайте первую закупку, чтобы оприходовать товары на склад.</p>
                                </td>
                            </tr>
                        <% } else { %>
                            <% purchases.forEach(item => { %>
                                <tr class="border-bottom-0">
                                    <td class="ps-4 text-secondary small"><%= item.formatted_date %></td>
                                    
                                    <td class="fw-bold text-dark">№ <%= item.number %></td>
                                    
                                    <td class="fw-semibold text-gray-700"><%= item.supplier_name || '—' %></td>
                                    
                                    <td>
                                        <span class="badge bg-light text-dark border p-2 rounded-2 fw-normal" style="font-size: 0.8rem;">
                                            🏢 <%= item.store_name || 'Не указан' %>
                                        </span>
                                    </td>
                                    
                                    <td class="text-end fw-bold text-dark">
                                        <%= Number(item.total_amount).toFixed(2) %> <span class="text-success">₴</span>
                                    </td>
                                    
                                    <td class="text-center">
                                        <% if (item.status === 'received') { %>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1.5 rounded-2 small fw-semibold" style="font-size: 0.75rem;">
                                                Проведено
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1.5 rounded-2 small fw-semibold" style="font-size: 0.75rem;">
                                                Черновик
                                            </span>
                                        <% } %>
                                    </td>
                                    
                                    <td class="pe-4 text-end">
                                        <div class="btn-group btn-group-sm bg-white border rounded-2 shadow-sm">
                                            <a href="/purchases/view/<%= item.id %>" class="btn btn-link text-secondary p-2 border-0" title="Просмотр накладной">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<%- include('blocks/footer') -%>