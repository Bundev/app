<!doctype html>
<html lang="en">
  <head>
    <%- include('blocks/head') -%>
  </head>
  <body>
    <div id="overlay"></div>
    <%- include('blocks/header') -%>
    <div class="container-fluid" id="cont">
      <div class="row">
        <%- include('blocks/menu') -%>
        <div class="col content">

<form
    method="POST"
    action="/users/stores/<%= user_st.id %>">

    <div class="card shadow-sm">

        <div class="card-header">

            🏪 Магазины сотрудника

        </div>

        <div class="card-body">

            <% stores.forEach(store => { %>

            <div class="form-check mb-2">

                <input
                    class="form-check-input"
                    type="checkbox"
                    name="stores"
                    value="<%= store.id %>"

                    <%= selectedStores.some(
                        s => s.store_id == store.id
                    )
                    ? 'checked'
                    : ''
                    %>
                >

                <label class="form-check-label">

                    <%= store.name %>

                </label>

            </div>

            <% }) %>

        </div>

        <div class="card-footer">

            <button
                class="btn btn-success">

                Сохранить

            </button>

        </div>

    </div>

</form>
        </div>
      </div>
    </div>
    <%- include('blocks/footer') -%>
  </body>
</html>