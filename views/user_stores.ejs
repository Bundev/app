<!doctype html>
<html lang="en">
  <head>
    <%- include('blocks/head') -%>
  </head>
  <body>
    <div id="overlay"></div>
    <%- include('blocks/header') -%>
    <div class="container-fluid" id="cont">
      <div class="row">
        <%- include('blocks/menu') -%>
        <div class="col content">

<form
    method="POST"
    action="/users/stores/<%= user_st.id %>">

    <div class="card shadow-sm">

        <div class="card-header">

            🏪 Магазины сотрудника

        </div>

        <div class="card-body">

        <% stores.forEach(store => { %>

        <label>

            <input
                type="checkbox"
                name="stores"
                value="<%= store.id %>"
                <%= selectedStores.includes(store.id) ? 'checked' : '' %>
            >

            <%= store.name %>

        </label>
        <br>
        <% }) %>

        </div>

        <div class="card-footer">

            <button
                class="btn btn-success">

                Сохранить

            </button>

        </div>

    </div>

</form>
        </div>
      </div>
    </div>
    <%- include('blocks/footer') -%>
  </body>
</html>