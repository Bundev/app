<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>
<div class="col content system-form-page employee-stores-page">

    <form
        method="POST"
        action="/user/stores/<%= user_st.id %>">

        <div class="card shadow-sm">

            <div class="card-header">

                🏪 Магазины сотрудника

            </div>

            <div class="card-body">

            <% stores.forEach(store => { %>

            <label>

                <input
                    type="checkbox"
                    name="stores"
                    value="<%= store.id %>"
                    <%= selectedStores.includes(store.id) ? 'checked' : '' %>
                >

                <%= store.name %>

            </label>
            <br>
            <% }) %>

            </div>

            <div class="card-footer">

                <button
                    class="btn btn-success">

                    Сохранить

                </button>

            </div>

        </div>

    </form>
</div>
<%- include('blocks/footer') -%>
