<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>

<div class="col content">
    
    <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-sm btn-outline-secondary rounded-2">
                <i class="bi bi-printer me-1"></i> Печать
            </button>
            <a href="/purchases" class="btn btn-sm btn-outline-primary rounded-2">
                <i class="bi bi-arrow-left me-1"></i> Назад в журнал
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm p-4 p-md-5 bg-white rounded-3">
        
        <div class="row border-bottom pb-4 mb-4">
            <div class="col-sm-6">
                <h3 class="fw-bold text-dark mb-1">
                    <i class="bi bi-file-earmark-text text-primary me-2 d-print-none"></i>Приходная накладная
                </h3>
                <p class="text-muted mb-0">Номер документа: <strong class="text-dark">№ <%= purchase.number || purchase.id %></strong></p>
                <p class="text-muted mb-0">Дата закупки: <strong class="text-dark"><%= new Date(purchase.date).toLocaleDateString('ru-RU') %></strong></p>
            </div>
            <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                <h4 class="text-muted fw-light">RetailPro CRM</h4>
                <div class="badge bg-success fs-6 rounded-2 px-3 py-2">Проведено</div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-sm-6 mb-3 mb-sm-0">
                <span class="text-muted small text-uppercase d-block mb-1">Поставщик:</span>
                <h5 class="fw-bold mb-1"><%= purchase.supplier_name || 'Не указан' %></h5>
                <% if (purchase.supplier_phone) { %>
                    <p class="text-muted small mb-0"><i class="bi bi-telephone me-1"></i> <%= purchase.supplier_phone %></p>
                <% } %>
            </div>
            <div class="col-sm-6 text-sm-end">
                <span class="text-muted small text-uppercase d-block mb-1">Склад поступления:</span>
                <h5 class="fw-bold mb-1">
                    <i class="bi bi-building me-1 text-muted small"></i> <%= purchase.store_name || 'Основной склад' %>
                </h5>
                <p class="text-muted small mb-0">Провел документ: <%= purchase.user_name || 'Администратор' %></p>
            </div>
        </div>

        <div class="table-responsive mb-4">
            <table class="table table-striped align-middle">
                <thead class="table-light text-secondary">
                    <tr>
                        <th style="width: 6%" class="ps-3">№</th>
                        <th>Товар (Наименование)</th>
                        <th style="width: 15%" class="text-center">Кол-во</th>
                        <th style="width: 18%" class="text-end">Цена закупки</th>
                        <th style="width: 18%" class="text-end pe-3">Сумма</th>
                    </tr>
                </thead>
                <tbody>
                    <% items.forEach((item, index) => { %>
                        <tr>
                            <td class="ps-3 text-muted"><%= index + 1 %></td>
                            <td class="fw-medium text-dark"><%= item.product_name %></td>
                            <td class="text-center"><%= parseFloat(item.quantity) %></td>
                            <td class="text-end"><%= parseFloat(item.price).toFixed(2) %> ₴</td>
                            <td class="text-end fw-bold text-dark pe-3">
                                <%= (item.quantity * item.price).toFixed(2) %> ₴
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <div class="row justify-content-end">
            <div class="col-md-5 text-end">
                <div class="p-3 bg-light rounded-2 d-inline-block w-100">
                    <span class="text-muted text-uppercase small d-block mb-1">Итого к оплате:</span>
                    <h2 class="fw-bold text-dark m-0"><%= parseFloat(purchase.total_amount).toFixed(2) %> ₴</h2>
                </div>
            </div>
        </div>

    </div>
</div>

<%- include('blocks/footer') -%>