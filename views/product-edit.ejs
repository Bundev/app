<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>
<div class="col content">
    <div class="card shadow-sm border-0">
        <div class="card-header">

            <h4 class="mb-0">

                Редактирование товара

            </h4>

        </div>

        <div class="card-body">

            <form
                method="POST"
                action="/products/edit/<%= product.id %>" enctype="multipart/form-data">

                <div class="row">
                    <div class="text-center mb-3">

                        <% if(product.image){ %>

                            <img
                                id="preview"
                                src="<%= product.image %>"
                                class="img-thumbnail"
                                style="max-height:250px">

                        <% } else { %>

                            <img
                                id="preview"
                                src="/img/no-image.png"
                                class="img-thumbnail"
                                style="max-height:250px">

                        <% } %>

                    </div>
                    <div class="col-md-6 mb-3">

                        <label class="form-label">

                            Фото товара

                        </label>

                        <input
                            type="file"
                            name="image"
                            class="form-control"
                            accept="image/*">

                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Категория</label>
                        <div class="input-group">
                            <div class="position-relative">

                                <input
                                    type="hidden"
                                    id="category_id"
                                    name="category_id" value="<%= product.category_id %>">

                                <input
                                    type="text"
                                    id="category_name"
                                    class="form-control"
                                    autocomplete="off"
                                    placeholder="Категория" value="<%= product.category_name || '' %>" required>

                                <div
                                    id="categoryList"
                                    class="list-group position-absolute w-100 d-none">
                                </div>

                            </div>
                            <script>
                            const categories = <%- JSON.stringify(categories) %>;
                            </script>

                            <button
                                type="button"
                                class="btn btn-outline-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#categoryModal">
                                +
                            </button>

                        </div>
                    </div>
                    <div class="col-md-8 mb-3">

                        <label class="form-label">

                            Название товара

                        </label>

                        <input
                            type="text"
                            name="name"
                            class="form-control"
                            value="<%= product.name %>"
                            required>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label class="form-label">

                            Артикул

                        </label>

                        <input
                            type="text"
                            name="sku"
                            class="form-control"
                            value="<%= product.sku || '' %>">

                    </div>

                    <div class="col-md-4 mb-3">

                        <label class="form-label">

                            Штрихкод

                        </label>

                        <div class="input-group">
                            <button
                                    type="button"
                                    id="scanBtn"
                                    class="btn btn-outline-primary d-md-none" title="Сканер штрихкод">

                                    <i class="bi bi-upc-scan"></i>

                                </button>
                            <input
                                type="text"
                                id="barcode"
                                name="barcode"
                                class="form-control"
                                value="<%= product.barcode || '' %>">

                            <button
                                type="button"
                                class="btn btn-outline-primary"
                                onclick="generateBarcode()" title="Генратор штрихкод">

                                <i class="bi bi-upc"></i>

                            </button>

                        </div>
                        <div id="scannerModal">

                                <div class="scanner-content">

                                    <div class="scanner-header">

                                        <span>
                                            📷 Сканирование товара
                                        </span>

                                        <button
                                            id="closeScanner"
                                            type="button">

                                            ✕
                                        </button>

                                    </div>

                                    <div id="reader"></div>

                                    <div class="scanner-footer">

                                        Наведите камеру на штрихкод

                                    </div>

                                </div>

                            </div>

                    </div>

                    

                    <div class="col-md-4 mb-3">

                        <label class="form-label">

                            Закупочная цена

                        </label>

                        <input
                            type="number"
                            step="0.01"
                            name="purchase_price"
                            id="purchase_price"
                            class="form-control"
                            value="<%= product.purchase_price || '' %>" required>

                    </div>
                    <script>
                        const USD_RATE = <%= usdRate %>;
                        const EUR_RATE = <%= eurRate %>;
                    </script>
                    <div class="col-md-4 mb-3">

                        <label class="form-label">

                            Цена продажи

                        </label>

                        <input
                            type="number"
                            step="0.01"
                            name="sale_price"
                            id="sale_price"
                            class="form-control"
                            value="<%= product.sale_price || '' %>" required>

                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Наценка (%)</label>
                        <input
                            type="text"
                            id="markup_percent"
                            class="form-control"
                            readonly>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Прибыль (грн) <small id="profitStatus"></small></label>
                        <input
                            type="text"
                            id="profit_amount"
                            class="form-control"
                            readonly>
                    </div>

<div class="col-md-4 mb-3">

<table class="table table-sm">

    <thead>
        <tr>
            <th>Магазин</th>
            <th>Остаток</th>
        </tr>
    </thead>

    <tbody>

        <% storeStocks.forEach(store => { %>

        <tr>

            <td>
                <%= store.name %>
            </td>

            <td>

                <input
                    type="number"
                    min="0"
                    class="form-control"
                    name="quantity_<%= store.id %>"
                    value="<%= store.quantity %>">

            </td>

        </tr>

        <% }) %>

    </tbody>

</table>
</div>

                    <div class="col-12 mb-3">

                        <label class="form-label">

                            Описание

                        </label>

                        <textarea
                            name="description"
                            rows="5"
                            class="form-control"><%= product.description || '' %></textarea>

                    </div>

                </div>

                <div class="d-flex gap-2">

                    <button
                        type="submit"
                        class="btn btn-success">

                        💾 Сохранить

                    </button>

                    <a
                        href="/products"
                        class="btn btn-secondary">

                        Отмена

                    </a>

                </div>

            </form>

        </div>

    </div>
</div>
<div class="modal fade" id="categoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Новая категория
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <div class="mb-3">
                    <label class="form-label">
                        Название категории
                    </label>

                    <input
                        type="text"
                        id="newCategoryName"
                        class="form-control">
                </div>

            </div>

            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">
                    Отмена
                </button>

                <button
                    type="button"
                    id="saveCategoryBtn"
                    class="btn btn-primary">
                    Сохранить
                </button>

            </div>

        </div>
    </div>
</div>
<%- include('blocks/footer') -%>