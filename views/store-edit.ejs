<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>
<div class="col content system-form-page store-form-page">
    <div class="container-fluid">
        <div class="d-flex align-items-center mb-4">
            <span class="fs-2 me-3"><i class="bi bi-shop"></i></span>
            <div>
                <h2 class="mb-0">Редактирование магазина</h2>
                <small class="text-muted">Обновите данные торговой точки</small>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <% if (error) { %>
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i><%= error %>
                </div>
                <% } %>
                <form method="POST" action="/stores/<%= store.id %>/edit">
                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="store-name">Название магазина</label>
                        <input id="store-name" type="text" name="name" class="form-control form-control-lg" value="<%= store.name %>" maxlength="255" required>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="store-address">Адрес</label>
                        <input id="store-address" type="text" name="address" class="form-control form-control-lg" value="<%= store.address || '' %>" maxlength="255">
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="store-phone">Телефон</label>
                        <input id="store-phone" type="tel" name="phone" class="form-control form-control-lg" value="<%= store.phone || '' %>" maxlength="20">
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-floppy me-1"></i>Сохранить</button>
                        <a href="/settings?tab=stores" class="btn btn-light">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<%- include('blocks/footer') -%>
