<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>

<main class="col content product-view-page">
    <div class="product-view-shell">
        <header class="product-view-heading">
            <div class="product-view-title-wrap">
                <span class="product-view-title-icon" aria-hidden="true">
                    <i class="bi bi-box-seam"></i>
                </span>
                <div>
                    <h1><%= product.name %></h1>
                    <p>Артикул: <strong><%= product.sku || '—' %></strong></p>
                </div>
            </div>

            <a href="/products/edit/<%= product.id %>" class="product-view-edit" aria-label="Редактировать товар" title="Редактировать">
                <i class="bi bi-pencil"></i>
            </a>
        </header>

        <div class="product-view-grid">
            <aside class="product-photo-card">
                <% if (product.image) { %>
                    <img src="<%= product.image %>" alt="<%= product.name %>">
                <% } else { %>
                    <div class="product-photo-empty">
                        <i class="bi bi-image" aria-hidden="true"></i>
                        <span>Изображение не добавлено</span>
                    </div>
                <% } %>
            </aside>

            <div class="product-view-content">
                <section class="product-view-card">
                    <div class="product-view-card-header">
                        <h2>Информация о товаре</h2>
                    </div>
                    <div class="product-info-grid">
                        <div class="product-info-item">
                            <span>Категория</span>
                            <strong><%= product.category_name || '—' %></strong>
                        </div>
                        <div class="product-info-item">
                            <span>Закупочная цена</span>
                            <strong class="value-muted"><%= Number(product.purchase_price).toFixed(2) %> ₴</strong>
                        </div>
                        <div class="product-info-item">
                            <span>Цена продажи</span>
                            <strong class="value-success"><%= Number(product.sale_price).toFixed(2) %> ₴</strong>
                        </div>
                        <div class="product-info-item">
                            <span>Прибыль</span>
                            <strong class="value-success"><%= (Number(product.sale_price) - Number(product.purchase_price)).toFixed(2) %> ₴</strong>
                        </div>
                        <div class="product-info-item">
                            <span>Наценка</span>
                            <strong class="value-warning"><%= Number(product.purchase_price) > 0 ? ((Number(product.sale_price) - Number(product.purchase_price)) / Number(product.purchase_price) * 100).toFixed(1) : 0 %> %</strong>
                        </div>
                        <div class="product-info-item">
                            <span>Штрихкод</span>
                            <strong><%= product.barcode || '—' %></strong>
                        </div>
                    </div>
                </section>

                <section class="product-view-card">
                    <div class="product-view-card-header product-view-card-title-icon">
                        <i class="bi bi-box-seam" aria-hidden="true"></i>
                        <h2>Остатки по магазинам</h2>
                    </div>
                    <div class="table-responsive">
                        <table class="product-stock-table">
                            <thead>
                                <tr>
                                    <th>Магазин</th>
                                    <th>Остаток</th>
                                    <th>Место хранения</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (storeStocks.length) { %>
                                    <% storeStocks.forEach(store => { %>
                                        <tr>
                                            <td><strong><%= store.name %></strong></td>
                                            <td>
                                                <span class="stock-badge <%= store.quantity > 10 ? 'is-success' : store.quantity > 0 ? 'is-warning' : 'is-danger' %>">
                                                    <%= store.quantity || 0 %>
                                                </span>
                                            </td>
                                            <td><%= store.location || '—' %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="3" class="product-stock-empty">Остатки не указаны</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </section>

                <section class="product-view-card">
                    <div class="product-view-card-header product-view-card-title-icon">
                        <i class="bi bi-text-left" aria-hidden="true"></i>
                        <h2>Описание</h2>
                    </div>
                    <div class="product-description">
                        <%= product.description || 'Описание отсутствует' %>
                    </div>
                </section>
            </div>
        </div>
    </div>
</main>

<%- include('blocks/footer') -%>
