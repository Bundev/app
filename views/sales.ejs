<!doctype html>
<html lang="en">
  <head>
    <%- include('blocks/head') -%>
  </head>
  <body>
    <%- include('blocks/header') -%>
    <div class="container-fluid" id="cont">
      <div class="row">
        <div class="col-2">
          <%- include('blocks/menu') -%>
        </div>
        <div class="col-10">
            <div class="buttonblox">
                <a href="/new/<%= nextInvoiceNumber %>" class="btn btn-primary">+ <%= __('title.new') %></a>
            </div>
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">

                    <div class="row g-2">

                        <div class="col-md-2">
                            <input
                                type="text"
                                id="filter-number"
                                class="form-control"
                                placeholder="№ чека">
                        </div>

                        <div class="col-md-2">
                            <input
                                type="date"
                                id="filter-date"
                                class="form-control">
                        </div>

                        <div class="col-md-3">
                            <input
                                type="text"
                                id="filter-customer"
                                class="form-control"
                                placeholder="Покупатель">
                        </div>
                        <div class="col-md-2">
                            <input
                                type="number"
                                id="filter-sum"
                                class="form-control"
                                placeholder="Сумма от">
                        </div>
                        <div class="col-md-2">
                            <select
                                id="filter-status"
                                class="form-select">

                                <option value="">
                                    Все статусы
                                </option>



                                 <% Object.keys(statuses).forEach(key => { %>

                                    <option value="<%= statuses[key].title %>">

                                        <%= statuses[key].title %>

                                    </option>

                                <% }) %>


                            </select>
                        </div>

                        

                        <div class="col-md-1">
                            <button
                                class="btn btn-outline-secondary w-100"
                                onclick="clearFilters()">

                                ✕
                            </button>
                        </div>

                    </div>

                </div>
            </div>
            
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">

                        <div class="table-scroll">
                            <table class="table table-hover align-middle mb-0 invoice-list">

                                <thead>

                                    <tr>
                                        <th width="120">№</th>
                                        <th width="150">Дата</th>
                                        <th>Клиент</th>
                                        <th width="180">Сумма</th>
                                        <th width="180">Статус</th>
                                    </tr>

                                </thead>

                                <tbody id="invoice-table">

                                    <% invoices.forEach(invoice => { %>

                                    <tr
                                        class="invoice-row"
                                        data-url="/invoices/<%= invoice.number %>">

                                        <td>
                                            <span class="invoice-number">
                                                №<%= invoice.number %>
                                            </span>
                                        </td>

                                        <td data-date="<%= invoice.date %>">
                                            <%= new Date(invoice.date).toLocaleDateString('ru-RU') %>
                                        </td>

                                        <td>
                                            <strong>
                                                <%= invoice.customer %>
                                            </strong>
                                        </td>

                                        <td>
                                            <span class="invoice-total">
                                                <%= Number(invoice.total)
                                                .toFixed(2) %> ₴
                                            </span>
                                        </td>
                                        <td><span class="badge <%= statuses[invoice.status].class %>"><%= statuses[invoice.status].title %></span></td>
                                    </tr>

                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            
        </div>
      </div>
    </div>
    <%- include('blocks/footer') -%>
  </body>
</html>