<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%=title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/seles.css">
  </head>
  <body>
    <%- include('blocks/header') -%>
    <div class="container-fluid" id="cont">
      <div class="row">
        <div class="col-2">
          <%- include('blocks/menu') -%>
        </div>
        <div class="col-10">
          <div class="buttonblox">
            <a href="/new/<%= nextInvoiceNumber %>" class="btn btn-primary">+ Новый чек</a>
          </div>
<div class="card mb-3">
    <div class="card-body">

        <div class="row g-2">

            <div class="col-md-2">
                <input
                    type="text"
                    id="filter-number"
                    class="form-control"
                    placeholder="№ чека">
            </div>

            <div class="col-md-2">
                <input
                    type="date"
                    id="filter-date"
                    class="form-control">
            </div>

            <div class="col-md-3">
                <input
                    type="text"
                    id="filter-customer"
                    class="form-control"
                    placeholder="Покупатель">
            </div>
            <div class="col-md-2">
                <input
                    type="number"
                    id="filter-sum"
                    class="form-control"
                    placeholder="Сумма от">
            </div>
            <div class="col-md-2">
                <select
                    id="filter-status"
                    class="form-select">

                    <option value="">
                        Все статусы
                    </option>

                    <option value="Оплачен">
                        Оплачен
                    </option>

                    <option value="В обработке">
                        В обработке
                    </option>

                </select>
            </div>

            

            <div class="col-md-1">
                <button
                    class="btn btn-outline-secondary w-100"
                    onclick="clearFilters()">

                    ✕
                </button>
            </div>

        </div>

    </div>
</div>



<div class="card border-0 shadow-sm">

    <div class="card-body p-0">

        <table class="table table-hover align-middle mb-0 invoice-list">

            <thead>

                <tr>
                    <th width="120">№</th>
                    <th width="150">Дата</th>
                    <th>Клиент</th>
                    <th width="180">Сумма</th>
                    <th width="180">Статус</th>
                </tr>

            </thead>

            <tbody id="invoice-table">

                <% invoices.forEach(invoice => { %>

                <tr
                    class="invoice-row"
                    data-url="/invoices/<%= invoice.number %>">

                    <td>
                        <span class="invoice-number">
                            №<%= invoice.number %>
                        </span>
                    </td>

                    <td>
                        <%= new Date(invoice.date)
                        .toLocaleDateString('ru-RU') %>
                    </td>

                    <td>
                        <strong>
                            <%= invoice.customer %>
                        </strong>
                    </td>

                    <td>
                        <span class="invoice-total">
                            <%= Number(invoice.total)
                            .toFixed(2) %> ₴
                        </span>
                    </td>

                    <td>

                        <% if (invoice.status === 'Новый') { %>

                            <span class="badge rounded-pill bg-primary">
                                Новый
                            </span>

                        <% } else if (invoice.status === 'processing') { %>

                            <span class="badge rounded-pill bg-warning text-dark">
                                В обработке
                            </span>

                        <% } else if (invoice.status === 'paid') { %>

                            <span class="badge rounded-pill bg-success">
                                Оплачен
                            </span>

                        <% } %>

                    </td>

                </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>
        </div>
      </div>
    </div>
    <%- include('blocks/footer') -%>
    <script src="/js/sales.js"></script>
  </body>
</html>