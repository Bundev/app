        <%- include('blocks/head') -%>
        <%- include('blocks/header') -%>
        <%- include('blocks/menu') -%>
        <%
            const saleRows = Array.isArray(sales) ? sales : [];
            const kyivDateFormatter = new Intl.DateTimeFormat('en-CA', {
                timeZone: 'Europe/Kyiv',
                year: 'numeric',
                month: '2-digit',
                day: '2-digit'
            });
            const kyivToday = kyivDateFormatter.format(new Date());
        %>
        <div class="col content sales-page">
            <div class="sales-shell">
            <header class="sales-header">
                <div class="sales-actions">
                <a href="/sales/today" class="sales-secondary-action">
                    <i class="bi bi-box-seam"></i>Продано сегодня
                </a>
                <a href="/return" class="sales-secondary-action">
                    <i class="bi bi-arrow-counterclockwise"></i>Возвраты
                </a>
                <a href="/sales/new" class="sales-primary-action" aria-keyshortcuts="Alt+N" title="Новый чек — Alt+N">
                    <i class="bi bi-plus-lg"></i><%= __('title.new') %>
                </a>
                </div>
            </header>

            <section class="sales-filters-card">
                <div class="sales-section-heading">
                    <div><h2>Фильтры</h2><p>Найдите чек по любому параметру</p></div>
                    <i class="bi bi-funnel"></i>
                </div>
                <div class="card-body">
                    <div class="row g-1 sales-filters">

                        <div class="col-md-2">

                            <input
                                type="text"
                                id="filterInvoice"
                                class="form-control"
                                placeholder="№ чека">

                        </div>

                        <div class="col-md-2">

                            <input
                                type="date"
                                id="filterDate"
                                class="form-control"
                                aria-label="Дата продажи">

                        </div>

                        <div class="col-md-2">

                            <input
                                type="text"
                                id="filterCustomer"
                                class="form-control"
                                placeholder="Покупатель">

                        </div>

                        <div class="col-md-2">

                            <input
                                type="number"
                                id="filterAmount"
                                class="form-control"
                                placeholder="Сумма от">

                        </div>

                        <div class="col-md-2">

                            <select
                                id="filterStatus"
                                class="form-select">

                                <option value="">
                                    Все статусы
                                </option>

                                <option value="completed">
                                    Продажа
                                </option>
                                <option value="partial_return">
                                    Частичный возврат
                                </option>
                                <option value="returned">
                                    Возврат
                                </option>

                            </select>

                        </div>

                        <div class="col-md-2">

                            <input
                                type="text"
                                id="filterCashier"
                                class="form-control"
                                placeholder="Кассир">

                        </div>

                        <div class="col-md-2">

                            <input
                                type="text"
                                id="filterStore"
                                class="form-control"
                                placeholder="Магазин">

                        </div>

                        <div class="col-md-2">

                            <input
                                type="number"
                                id="filterItems"
                                class="form-control"
                                min="0"
                                placeholder="Позиций от">

                        </div>

                    </div>
                </div>
            </section>


            <section class="sales-list-card">
                <div class="sales-list-heading">
                    <div><h2>Журнал продаж</h2><p>Нажмите на строку, чтобы открыть чек</p></div>
                    <span class="sales-count"><%= saleRows.length %></span>
                </div>

                <div class="table-wrapper border-0 ">

<table class="table table-hover align-middle mb-0 sales-list-table">
    <thead class="table-light text-muted small fw-bold text-uppercase">
        <tr>
            <th class="ps-3" style="width: 120px;">Чек</th>
            <th style="width: 160px;">Дата / Время</th>
            <th>Клиент</th>
            <th style="width: 170px;">Кассир</th>
            <th style="width: 160px;">Магазин</th>
            <th class="text-center" style="width: 100px;">Позиций</th>
            <th class="text-end" style="width: 140px;">Сумма</th>
            <th class="text-center" style="width: 150px;">Статус</th>
            
        </tr>
    </thead>
    <tbody id="salesTable" data-last-id="<%= sales[0]?.id || 0 %>">
        <% sales.forEach(sale => { %>
            <tr class="invoice-row"
                data-id="<%= sale.id %>"
                data-url="/sales/<%= sale.id %>"
                data-invoice="<%= sale.invoice_number %>"
                data-customer="<%= sale.customer_name || '' %>"
                data-cashier="<%= sale.user_name || '' %>"
                data-store="<%= sale.store_name || '' %>"
                data-items="<%= sale.item_count || 0 %>"
                data-total="<%= sale.total %>"
                data-status="<%= sale.status %>"
                data-date="<%= kyivDateFormatter.format(new Date(sale.created_at)) %>">
                
                <td class="ps-3">
                    <span class="badge bg-light text-dark border fw-medium px-2 py-1.5">
                        <%= sale.invoice_number %>
                    </span>
                </td>

                <td>
                    <span class="fw-semibold text-dark">
                        <% if (kyivDateFormatter.format(new Date(sale.created_at)) !== kyivToday) { %>
                            <%= new Date(sale.created_at).toLocaleDateString('ru-RU', { timeZone: 'Europe/Kyiv' }) %>
                        <% } %>
                        <i class="bi bi-clock ms-1 me-1" style="font-size: 11px;"></i>
                        <%= new Date(sale.created_at).toLocaleTimeString('ru-RU', { timeZone: 'Europe/Kyiv', hour: '2-digit', minute: '2-digit' }) %>
                    </span>
                </td>

                <td>
                    <div class="fw-medium text-dark">
                        <i class="bi bi-person text-muted me-1"></i><%= sale.customer_name || 'Розничный покупатель' %>
                    </div>
                </td>

                <td>
                    <span class="text-muted">
                        <i class="bi bi-person-badge me-1"></i><%= sale.user_name || 'Не указан' %>
                    </span>
                </td>

                <td>
                    <span class="text-muted">
                        <i class="bi bi-shop me-1"></i><%= sale.store_name || 'Не указан' %>
                    </span>
                </td>

                <td class="text-center">
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-box-seam me-1"></i><%= sale.item_count %>
                    </span>
                </td>

                <td class="text-end fw-bold text-dark">
                    <%= Number(sale.total).toFixed(2) %> ₴
                </td>

                <td class="text-center">
                    <% if (sale.status === 'returned') { %>
                        <span class="sale-status sale-status--returned">
                            <i class="bi bi-arrow-return-left"></i>Полный возврат
                        </span>
                    <% } else if (sale.status === 'partial_return') { %>
                        <span class="sale-status sale-status--partial">
                            <i class="bi bi-arrow-return-left"></i>Частичный возврат
                        </span>
                    <% } else { %>
                        <span class="sale-status sale-status--completed">
                            <i class="bi bi-check2-circle"></i>Продажа
                        </span>
                    <% } %>
                </td>

                
            </tr>
        <% }) %>
    </tbody>
</table>

                </div>

            </section>
            </div>
        </div>

    <%- include('blocks/footer') -%>
