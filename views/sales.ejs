        <%- include('blocks/head') -%>
        <%- include('blocks/header') -%>
        <%- include('blocks/menu') -%>
        <%
            const saleRows = Array.isArray(sales) ? sales : [];
            const completedSales = saleRows.filter(sale => sale.status === 'completed');
            const returnedSales = saleRows.filter(sale => sale.status === 'returned' || sale.status === 'partial_return');
            const salesTotal = completedSales.reduce((total, sale) => total + Number(sale.total || 0), 0);
            const averageSale = completedSales.length ? salesTotal / completedSales.length : 0;
        %>
        <div class="col content sales-page">
            <div class="sales-shell">
            <header class="sales-header">
                <div>
                    <div class="sales-eyebrow"><i class="bi bi-receipt"></i>История операций</div>
                    <h1>Продажи</h1>
                    <p>Чеки, покупатели, суммы и возвраты в одном журнале</p>
                </div>
                <div class="sales-actions">
                <a href="/return" class="sales-secondary-action">
                    <i class="bi bi-arrow-counterclockwise"></i>Возвраты
                </a>
                <a href="/sales/new" class="sales-primary-action">
                    <i class="bi bi-plus-lg"></i><%= __('title.new') %>
                </a>
                </div>
            </header>

            <section class="sales-metrics">
                <div class="sales-metric">
                    <span class="sales-metric-icon sales-metric-icon--primary"><i class="bi bi-receipt-cutoff"></i></span>
                    <span class="sales-metric-copy"><span>Чеков</span><strong><%= saleRows.length %></strong></span>
                </div>
                <div class="sales-metric">
                    <span class="sales-metric-icon sales-metric-icon--success"><i class="bi bi-cash-stack"></i></span>
                    <span class="sales-metric-copy"><span>Сумма продаж</span><strong><%= salesTotal.toLocaleString('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> ₴</strong></span>
                </div>
                <div class="sales-metric">
                    <span class="sales-metric-icon sales-metric-icon--warning"><i class="bi bi-graph-up"></i></span>
                    <span class="sales-metric-copy"><span>Средний чек</span><strong><%= averageSale.toLocaleString('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> ₴</strong></span>
                </div>
                <div class="sales-metric">
                    <span class="sales-metric-icon sales-metric-icon--danger"><i class="bi bi-arrow-return-left"></i></span>
                    <span class="sales-metric-copy"><span>С возвратом</span><strong><%= returnedSales.length %></strong></span>
                </div>
            </section>


            <section class="sales-filters-card">
                <div class="sales-section-heading">
                    <div><h2>Фильтры</h2><p>Найдите чек по любому параметру</p></div>
                    <i class="bi bi-funnel"></i>
                </div>
                <div class="card-body">
                    <div class="row g-1 sales-filters">

                        <div class="col-md-2">

                            <input
                                type="text"
                                id="filterInvoice"
                                class="form-control"
                                placeholder="№ чека">

                        </div>

                        <div class="col-md-2">

                            <input
                                type="date"
                                id="filterDate"
                                class="form-control"
                                aria-label="Дата продажи">

                        </div>

                        <div class="col-md-2">

                            <input
                                type="text"
                                id="filterCustomer"
                                class="form-control"
                                placeholder="Покупатель">

                        </div>

                        <div class="col-md-2">

                            <input
                                type="number"
                                id="filterAmount"
                                class="form-control"
                                placeholder="Сумма от">

                        </div>

                        <div class="col-md-2">

                            <select
                                id="filterStatus"
                                class="form-select">

                                <option value="">
                                    Все статусы
                                </option>

                                <option value="completed">
                                    Продажа
                                </option>
                                <option value="partial_return">
                                    Частичный возврат
                                </option>
                                <option value="returned">
                                    Возврат
                                </option>

                            </select>

                        </div>

                        <div class="col-md-2">

                            <input
                                type="text"
                                id="filterCashier"
                                class="form-control"
                                placeholder="Кассир">

                        </div>

                        <div class="col-md-2">

                            <input
                                type="text"
                                id="filterStore"
                                class="form-control"
                                placeholder="Магазин">

                        </div>

                        <div class="col-md-2">

                            <input
                                type="number"
                                id="filterItems"
                                class="form-control"
                                min="0"
                                placeholder="Позиций от">

                        </div>

                    </div>
                </div>
            </section>


            <section class="sales-list-card">
                <div class="sales-list-heading">
                    <div><h2>Журнал продаж</h2><p>Нажмите на строку, чтобы открыть чек</p></div>
                    <span class="sales-count"><%= saleRows.length %></span>
                </div>

                <div class="table-wrapper border-0 ">

<table class="table table-hover align-middle mb-0 sales-list-table">
    <thead class="table-light text-muted small fw-bold text-uppercase">
        <tr>
            <th class="ps-3" style="width: 120px;">Чек</th>
            <th style="width: 160px;">Дата / Время</th>
            <th>Клиент</th>
            <th style="width: 170px;">Кассир</th>
            <th style="width: 160px;">Магазин</th>
            <th class="text-center" style="width: 100px;">Позиций</th>
            <th class="text-end" style="width: 140px;">Сумма</th>
            <th class="text-center" style="width: 150px;">Статус</th>
            
        </tr>
    </thead>
    <tbody id="salesTable" data-last-id="<%= sales[0]?.id || 0 %>">
        <% sales.forEach(sale => { %>
            <tr class="invoice-row"
                data-id="<%= sale.id %>"
                data-url="/sales/<%= sale.id %>"
                data-invoice="<%= sale.invoice_number %>"
                data-customer="<%= sale.customer_name || '' %>"
                data-cashier="<%= sale.user_name || '' %>"
                data-store="<%= sale.store_name || '' %>"
                data-items="<%= sale.item_count || 0 %>"
                data-total="<%= sale.total %>"
                data-status="<%= sale.status %>"
                data-date="<%= new Date(sale.created_at).toISOString().split('T')[0] %>">
                
                <td class="ps-3">
                    <span class="badge bg-light text-dark border fw-medium px-2 py-1.5">
                        <%= sale.invoice_number %>
                    </span>
                </td>

                <td>
                    <span class="fw-semibold text-dark">
                        <%= new Date(sale.created_at).toLocaleDateString('ru-RU') %>
                        <i class="bi bi-clock ms-1 me-1" style="font-size: 11px;"></i><%= new Date(sale.created_at).toLocaleTimeString('ru-RU', { timeZone: 'Europe/Kyiv', hour: '2-digit', minute: '2-digit' }) %>
                    </span>
                </td>

                <td>
                    <div class="fw-medium text-dark">
                        <i class="bi bi-person text-muted me-1"></i><%= sale.customer_name || 'Розничный покупатель' %>
                    </div>
                </td>

                <td>
                    <span class="text-muted">
                        <i class="bi bi-person-badge me-1"></i><%= sale.user_name || 'Не указан' %>
                    </span>
                </td>

                <td>
                    <span class="text-muted">
                        <i class="bi bi-shop me-1"></i><%= sale.store_name || 'Не указан' %>
                    </span>
                </td>

                <td class="text-center">
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-box-seam me-1"></i><%= sale.item_count %>
                    </span>
                </td>

                <td class="text-end fw-bold text-dark">
                    <%= Number(sale.total).toFixed(2) %> ₴
                </td>

                <td class="text-center">
                    <% if (sale.status === 'returned') { %>
                        <span class="sale-status sale-status--returned">
                            <i class="bi bi-arrow-return-left"></i>Полный возврат
                        </span>
                    <% } else if (sale.status === 'partial_return') { %>
                        <span class="sale-status sale-status--partial">
                            <i class="bi bi-arrow-return-left"></i>Частичный возврат
                        </span>
                    <% } else { %>
                        <span class="sale-status sale-status--completed">
                            <i class="bi bi-check2-circle"></i>Продажа
                        </span>
                    <% } %>
                </td>

                
            </tr>
        <% }) %>
    </tbody>
</table>

                </div>

            </section>
            </div>
        </div>

    <%- include('blocks/footer') -%>
