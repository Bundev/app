<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>CRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/main.css">
  </head>
  <body>
    <%- include('blocks/header') -%>
    <div class="container-fluid" id="cont">
      <div class="row">
        <div class="col-2">
          <%- include('blocks/menu') -%>
        </div>
        <div class="col-10">
          <div class="buttonblox">
            <a href="/new" class="btn btn-primary">Создать</a>
          </div>
          <table class="table table-hover">
            <thead>
              <tr>
                <th>№</th>
                <th>Дата</th>
                <th>Клиент</th>
                <th>Сумма</th>
                <th>Статус</th>
                <th>Действия</th>
              </tr>
            </thead>

            <tbody>

              <tr>
                <td>1</td>
                <td>01.06.2026</td>
                <td>Иван Иванов</td>
                <td>450 ₴</td>
                <td>
                  <span class="badge bg-success">
                    Оплачено
                  </span>
                </td>
                <td>
                  <a href="/sales/1" class="btn btn-sm btn-primary">
                    Открыть
                  </a>
                </td>
              </tr>

              <tr>
                <td>2</td>
                <td>01.06.2026</td>
                <td>Петр Петров</td>
                <td>1200 ₴</td>
                <td>
                  <span class="badge bg-warning">
                    В обработке
                  </span>
                </td>
                <td>
                  <a href="/sales/2" class="btn btn-sm btn-primary">
                    Открыть
                  </a>
                </td>
              </tr>

            </tbody>
          </table>
        </div>
      </div>
    </div>
    <%- include('blocks/footer') -%>
  </body>
</html>