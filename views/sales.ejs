<!doctype html>
<html lang="en">
  <head>
    <%- include('blocks/head') -%>
  </head>
  <body>
    <div id="overlay"></div>
    <%- include('blocks/header') -%>
    <div class="container-fluid" id="cont">
      <div class="row">
        <%- include('blocks/menu') -%>
        <div class="col content">
            <div class="buttonblox">
                <a href="/new" class="btn btn-primary">+ <%= __('title.new') %></a>
            </div>


<div class="card mb-3">
    <div class="card-body">
<div class="row g-2 mb-3">

    <div class="col-md-2">

        <input
            type="text"
            id="filterInvoice"
            class="form-control"
            placeholder="№ чека">

    </div>

    <div class="col-md-2">

        <input
            type="date"
            id="dateFrom"
            class="form-control">

    </div>

    <div class="col-md-2">

        <input
            type="date"
            id="dateTo"
            class="form-control">

    </div>

    <div class="col-md-2">

        <input
            type="text"
            id="filterCustomer"
            class="form-control"
            placeholder="Покупатель">

    </div>

    <div class="col-md-2">

        <input
            type="number"
            id="filterAmount"
            class="form-control"
            placeholder="Сумма">

    </div>

    <div class="col-md-2">

        <select
            id="filterStatus"
            class="form-select">

            <option value="">
                Все статусы
            </option>

            <option value="completed">
                Продажа завершена
            </option>

            <option value="returned">
                Возврат
            </option>

        </select>

    </div>

</div>
    </div>
</div>


            <div class="card border-0 shadow-sm">

                <div class="table-wrapper">

                    <table class="table sales-table mb-0">

                        <thead>

                            <tr>
                                <th>Чек</th>
                                <th>Дата</th>
                                <th>Клиент</th>
                                <th class="text-end">Сумма</th>
                                <th class="text-center">Статус</th>
                                <th></th>
                            </tr>

                        </thead>

                        <tbody id="salesTable">

                        <% sales.forEach(sale => { %>

                            <tr class="invoice-row" data-url="/sale/<%= sale.id %>"
                             data-invoice="<%= sale.invoice_number %>"
                            data-customer="<%= sale.customer_name || '' %>"
                            data-total="<%= sale.total %>"
                            data-status="<%= sale.status %>"
                            data-date="<%= new Date(sale.created_at).toISOString().split('T')[0] %>">

                                <td>

                                    <span class="invoice-badge">
                                        <%= sale.invoice_number %>
                                    </span>

                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        <%= new Date(sale.created_at).toLocaleDateString('ru-RU') %>
                                    </div>

                                    <small class="text-muted">
                                        <%= new Date(sale.created_at).toLocaleTimeString(
                                            'ru-RU',
                                            {
                                                hour: '2-digit',
                                                minute: '2-digit'
                                            }
                                        ) %>
                                    </small>
                                    
                                </td>

                                <td>

                                    <div class="customer-name">
                                        <%= sale.customer_name || 'Розничный покупатель' %>
                                    </div>

                                </td>

                                <td class="text-end">

                                    <span class="sale-sum">
                                        <%= Number(sale.total).toFixed(2) %> ₴
                                    </span>

                                </td>

                                <td class="text-center">

                                    <span class="status-success">
                                        Продажа завершена
                                    </span>

                                </td>
                                <td> 

                                    <div class="btn-group btn-sm">
                                        <a
                                            href="/sale/<%= sale.id %>"
                                            class="btn btn-sm ">

                                            👁

                                        </a>
                                    </div>
                                </td>

                                

                            </tr>

                        <% }) %>

                        </tbody>

                    </table>

                </div>

            </div>  
        </div>
      </div>
    </div>
    <%- include('blocks/footer') -%>
  </body>
</html>