        <%- include('blocks/head') -%>
        <%- include('blocks/header') -%>
        <%- include('blocks/menu') -%>
        <div class="col content">
            <div class="buttonblox">
                <a href="/new" class="btn btn-primary">+ <%= __('title.new') %></a>
            </div>


            <div class="card border-0 mb-3">
                <div class="card-body ">
                    <div class="row g-2 mb-3">

                        <div class="col-md-2">

                            <input
                                type="text"
                                id="filterInvoice"
                                class="form-control"
                                placeholder="№ чека">

                        </div>

                        <div class="col-md-2">

                            <input
                                type="date"
                                id="dateFrom"
                                class="form-control">

                        </div>

                        <div class="col-md-2">

                            <input
                                type="date"
                                id="dateTo"
                                class="form-control">

                        </div>

                        <div class="col-md-2">

                            <input
                                type="text"
                                id="filterCustomer"
                                class="form-control"
                                placeholder="Покупатель">

                        </div>

                        <div class="col-md-2">

                            <input
                                type="number"
                                id="filterAmount"
                                class="form-control"
                                placeholder="Сумма">

                        </div>

                        <div class="col-md-2">

                            <select
                                id="filterStatus"
                                class="form-select">

                                <option value="">
                                    Все статусы
                                </option>

                                <option value="completed">
                                    Продажа
                                </option>
                                <option value="partial_return">
                                    Частичный возврат
                                </option>
                                <option value="returned">
                                    Возврат
                                </option>

                            </select>

                        </div>

                    </div>
                </div>
            </div>


            <div class="card border-0 shadow-sm">

                <div class="table-wrapper border-0 ">

<table class="table table-hover align-middle mb-0">
    <thead class="table-light text-muted small fw-bold text-uppercase">
        <tr>
            <th class="ps-3" style="width: 120px;">Чек</th>
            <th style="width: 160px;">Дата / Время</th>
            <th>Клиент</th>
            <th class="text-end" style="width: 140px;">Сумма</th>
            <th class="text-center" style="width: 150px;">Статус</th>
            <th class="pe-3 text-end" style="width: 100px;">Действия</th>
        </tr>
    </thead>
    <tbody id="salesTable" data-last-id="<%= sales[0]?.id || 0 %>">
        <% sales.forEach(sale => { %>
            <tr class="invoice-row" 
                data-url="/sale/<%= sale.id %>"
                data-invoice="<%= sale.invoice_number %>"
                data-customer="<%= sale.customer_name || '' %>"
                data-total="<%= sale.total %>"
                data-status="<%= sale.status %>"
                data-date="<%= new Date(sale.created_at).toISOString().split('T')[0] %>">
                
                <td class="ps-3">
                    <span class="badge bg-light text-dark border fw-medium px-2 py-1.5">
                        <%= sale.invoice_number %>
                    </span>
                </td>

                <td>
                    <div class="fw-semibold text-dark">
                        <%= new Date(sale.created_at).toLocaleDateString('ru-RU') %>
                    </div>
                    <div class="text-muted small">
                        <i class="bi bi-clock me-1" style="font-size: 11px;"></i><%= new Date(sale.created_at).toLocaleTimeString('ru-RU', { timeZone: 'Europe/Kyiv', hour: '2-digit', minute: '2-digit' }) %>
                    </div>
                </td>

                <td>
                    <div class="fw-medium text-dark">
                        <i class="bi bi-person text-muted me-1"></i><%= sale.customer_name || 'Розничный покупатель' %>
                    </div>
                </td>

                <td class="text-end fw-bold text-dark">
                    <%= Number(sale.total).toFixed(2) %> ₴
                </td>

                <td class="text-center">
                    <% if (sale.status === 'returned') { %>
                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 w-100 py-1.5">
                            ↩️ Полный возврат
                        </span>
                    <% } else if (sale.status === 'partial_return') { %>
                        <span class="badge bg-warning bg-opacity-10 text-warning-emphasis border border-warning border-opacity-50 w-100 py-1.5">
                            ⚠️ Частичный возврат
                        </span>
                    <% } else { %>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 w-100 py-1.5">
                            📦 Продажа
                        </span>
                    <% } %>
                </td>

                <td class="pe-3 text-end">
                    <div class="btn-group shadow-sm">
                        <a href="/sale/<%= sale.id %>" class="btn btn-sm btn-outline-secondary border-end-0" title="Просмотр" target="_blank">
                            <i class="bi bi-eye text-primary"></i>
                        </a>
                        <a href="/sales/print/<%= sale.id %>" class="btn btn-sm btn-outline-secondary" title="Печать" target="_blank">
                            <i class="bi bi-printer text-success"></i>
                        </a>
                    </div>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

                </div>

            </div>  
        </div>

    <%- include('blocks/footer') -%>
  