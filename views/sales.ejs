        <%- include('blocks/head') -%>
        <%- include('blocks/header') -%>
        <%- include('blocks/menu') -%>
        <div class="col content">
            <div class="buttonblox">
                <a href="/sales/new" class="btn btn-primary">+ <%= __('title.new') %></a>
                <a href="/return" class="btn btn-outline-warning ms-2">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Возвраты
                </a>
            </div>


            <div class="card border-0 mb-3">
                <div class="card-body ">
                    <div class="row g-2 mb-3">

                        <div class="col-md-2">

                            <input
                                type="text"
                                id="filterInvoice"
                                class="form-control"
                                placeholder="№ чека">

                        </div>

                        <div class="col-md-2">

                            <input
                                type="date"
                                id="dateFrom"
                                class="form-control">

                        </div>

                        <div class="col-md-2">

                            <input
                                type="date"
                                id="dateTo"
                                class="form-control">

                        </div>

                        <div class="col-md-2">

                            <input
                                type="text"
                                id="filterCustomer"
                                class="form-control"
                                placeholder="Покупатель">

                        </div>

                        <div class="col-md-2">

                            <input
                                type="number"
                                id="filterAmount"
                                class="form-control"
                                placeholder="Сумма">

                        </div>

                        <div class="col-md-2">

                            <select
                                id="filterStatus"
                                class="form-select">

                                <option value="">
                                    Все статусы
                                </option>

                                <option value="completed">
                                    Продажа
                                </option>
                                <option value="partial_return">
                                    Частичный возврат
                                </option>
                                <option value="returned">
                                    Возврат
                                </option>

                            </select>

                        </div>

                    </div>
                </div>
            </div>


            <div class="card border-0 shadow-sm">

                <div class="table-wrapper border-0 ">

<table class="table table-hover align-middle mb-0">
    <thead class="table-light text-muted small fw-bold text-uppercase">
        <tr>
            <th class="ps-3" style="width: 120px;">Чек</th>
            <th style="width: 160px;">Дата / Время</th>
            <th>Клиент</th>
            <th class="text-center" style="width: 100px;">Позиций</th>
            <th class="text-end" style="width: 140px;">Сумма</th>
            <th class="text-center" style="width: 150px;">Статус</th>
            
        </tr>
    </thead>
    <tbody id="salesTable" data-last-id="<%= sales[0]?.id || 0 %>">
        <% sales.forEach(sale => { %>
            <tr class="invoice-row"
                data-id="<%= sale.id %>"
                data-url="/sales/<%= sale.id %>"
                data-invoice="<%= sale.invoice_number %>"
                data-customer="<%= sale.customer_name || '' %>"
                data-total="<%= sale.total %>"
                data-status="<%= sale.status %>"
                data-date="<%= new Date(sale.created_at).toISOString().split('T')[0] %>">
                
                <td class="ps-3">
                    <span class="badge bg-light text-dark border fw-medium px-2 py-1.5">
                        <%= sale.invoice_number %>
                    </span>
                </td>

                <td>
                    <span class="fw-semibold text-dark">
                        <%= new Date(sale.created_at).toLocaleDateString('ru-RU') %>
                        <i class="bi bi-clock ms-1 me-1" style="font-size: 11px;"></i><%= new Date(sale.created_at).toLocaleTimeString('ru-RU', { timeZone: 'Europe/Kyiv', hour: '2-digit', minute: '2-digit' }) %>
                    </span>
                </td>

                <td>
                    <div class="fw-medium text-dark">
                        <i class="bi bi-person text-muted me-1"></i><%= sale.customer_name || 'Розничный покупатель' %>
                    </div>
                </td>

                <td class="text-center">
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-box-seam me-1"></i><%= sale.item_count %>
                    </span>
                </td>

                <td class="text-end fw-bold text-dark">
                    <%= Number(sale.total).toFixed(2) %> ₴
                </td>

                <td class="text-center">
                    <% if (sale.status === 'returned') { %>
                        <span class="sale-status sale-status--returned">
                            <i class="bi bi-arrow-return-left"></i>Полный возврат
                        </span>
                    <% } else if (sale.status === 'partial_return') { %>
                        <span class="sale-status sale-status--partial">
                            <i class="bi bi-arrow-return-left"></i>Частичный возврат
                        </span>
                    <% } else { %>
                        <span class="sale-status sale-status--completed">
                            <i class="bi bi-check2-circle"></i>Продажа
                        </span>
                    <% } %>
                </td>

                
            </tr>
        <% }) %>
    </tbody>
</table>

                </div>

            </div>  
        </div>

    <%- include('blocks/footer') -%>
