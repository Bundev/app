<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>

<%
    const supplierList = Array.isArray(suppliers) ? suppliers : [];
    const storeList = Array.isArray(stores) ? stores : [];
    const productList = Array.isArray(products) ? products : [];
    const purchaseToday = typeof today !== 'undefined' && today
        ? today
        : new Date().toISOString().slice(0, 10);
    const canCreatePurchase = supplierList.length > 0 && storeList.length > 0 && productList.length > 0;
    const productCatalog = productList.map(product => ({
        id: Number(product.id),
        name: String(product.name || ''),
        sku: product.sku ? String(product.sku) : '',
        unit: product.unit ? String(product.unit) : '',
        purchasePrice: Number(product.purchase_price || 0)
    }));
    const productCatalogJson = JSON.stringify(productCatalog)
        .replace(/&/g, '\\u0026')
        .replace(/</g, '\\u003c')
        .replace(/>/g, '\\u003e')
        .replace(/\u2028/g, '\\u2028')
        .replace(/\u2029/g, '\\u2029');
%>

<main class="col content purchase-add-page">
    <div class="purchase-add-shell">
        <header class="purchase-add-header" aria-labelledby="purchaseAddTitle">
            <div>
                <div class="purchase-add-eyebrow">
                    <i class="bi bi-cart-plus-fill" aria-hidden="true"></i>
                    Новое поступление
                </div>
                <h1 id="purchaseAddTitle">Новая закупка</h1>
                <p>Заполните реквизиты накладной и добавьте товары, которые поступают на выбранный склад.</p>
            </div>

            <a href="/purchases" class="btn purchase-add-back">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                К журналу
            </a>
        </header>

        <% if (!canCreatePurchase) { %>
            <section class="purchase-prerequisites" role="alert">
                <span class="purchase-prerequisites-icon">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                </span>
                <div>
                    <h2>Перед созданием закупки нужна настройка</h2>
                    <p>Добавьте недостающие данные, затем вернитесь к этой форме.</p>
                    <div class="purchase-prerequisites-links">
                        <% if (supplierList.length === 0) { %>
                            <a href="/suppliers">
                                <i class="bi bi-truck" aria-hidden="true"></i>
                                Добавить поставщика
                            </a>
                        <% } %>
                        <% if (storeList.length === 0) { %>
                            <a href="/stores/new">
                                <i class="bi bi-building-add" aria-hidden="true"></i>
                                Добавить склад
                            </a>
                        <% } %>
                        <% if (productList.length === 0) { %>
                            <a href="/products/add">
                                <i class="bi bi-box-seam" aria-hidden="true"></i>
                                Добавить товар
                            </a>
                        <% } %>
                    </div>
                </div>
            </section>
        <% } %>

        <form action="/purchases/add" method="POST" id="purchaseForm" class="purchase-form">
            <div class="purchase-add-layout">
                <aside class="purchase-document-column">
                    <section class="purchase-form-card" aria-labelledby="purchaseDocumentTitle">
                        <div class="purchase-card-heading">
                            <span class="purchase-card-icon">
                                <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                            </span>
                            <span>
                                <h2 id="purchaseDocumentTitle">Параметры документа</h2>
                                <p>Основные реквизиты закупки</p>
                            </span>
                        </div>

                        <div class="purchase-field">
                            <label class="form-label" for="purchase_number">
                                Номер накладной <span aria-hidden="true">*</span>
                            </label>
                            <input
                                type="text"
                                id="purchase_number"
                                name="number"
                                class="form-control"
                                maxlength="50"
                                placeholder="Например, ПР-001"
                                autocomplete="off"
                                required
                            >
                        </div>

                        <div class="purchase-field">
                            <label class="form-label" for="purchase_date">
                                Дата закупки <span aria-hidden="true">*</span>
                            </label>
                            <input
                                type="date"
                                id="purchase_date"
                                name="date"
                                class="form-control"
                                value="<%= purchaseToday %>"
                                required
                            >
                        </div>

                        <div class="purchase-field">
                            <label class="form-label" for="purchase_supplier">
                                Поставщик <span aria-hidden="true">*</span>
                            </label>
                            <select
                                id="purchase_supplier"
                                name="supplier_id"
                                class="form-select"
                                required
                                <%= supplierList.length === 0 ? 'disabled' : '' %>
                            >
                                <option value="" selected>Выберите поставщика</option>
                                <% supplierList.forEach(supplier => { %>
                                    <option value="<%= supplier.id %>"><%= supplier.name %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="purchase-field">
                            <label class="form-label" for="purchase_store">
                                Склад поступления <span aria-hidden="true">*</span>
                            </label>
                            <select
                                id="purchase_store"
                                name="store_id"
                                class="form-select"
                                required
                                <%= storeList.length === 0 ? 'disabled' : '' %>
                            >
                                <option value="" selected>Выберите склад</option>
                                <% storeList.forEach(store => { %>
                                    <option value="<%= store.id %>"><%= store.name %></option>
                                <% }) %>
                            </select>
                        </div>
                    </section>

                    <section class="purchase-flow-note" aria-label="Что произойдёт после сохранения">
                        <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                        <div>
                            <strong>После проведения</strong>
                            <span>Количество товаров будет увеличено на выбранном складе.</span>
                        </div>
                    </section>
                </aside>

                <section class="purchase-items-card" aria-labelledby="purchaseCompositionTitle">
                    <div class="purchase-items-card-header">
                        <div class="purchase-card-heading">
                            <span class="purchase-card-icon purchase-card-icon--success">
                                <i class="bi bi-boxes" aria-hidden="true"></i>
                            </span>
                            <span>
                                <h2 id="purchaseCompositionTitle">Состав накладной</h2>
                                <p><span id="purchaseItemCount" aria-live="polite">0</span> выбранных позиций</p>
                            </span>
                        </div>

                        <button
                            type="button"
                            class="btn purchase-add-item"
                            id="addPurchaseItem"
                            <%= productList.length === 0 ? 'disabled' : '' %>
                        >
                            <i class="bi bi-plus-circle" aria-hidden="true"></i>
                            Добавить товар
                        </button>
                    </div>

                    <div class="purchase-items-columns" aria-hidden="true">
                        <span>№</span>
                        <span>Товар</span>
                        <span>Количество</span>
                        <span>Цена закупки</span>
                        <span>Сумма</span>
                        <span></span>
                    </div>

                    <div class="purchase-items-list" id="purchaseItemsList"></div>

                    <noscript>
                        <div class="purchase-script-warning">
                            Для добавления товаров включите JavaScript в браузере.
                        </div>
                    </noscript>

                    <footer class="purchase-items-footer">
                        <div class="purchase-grand-total">
                            <span>Итого к оплате</span>
                            <strong id="purchaseGrandTotal" aria-live="polite">0,00 ₴</strong>
                        </div>

                        <button
                            type="submit"
                            class="btn purchase-submit"
                            id="purchaseSubmit"
                            <%= canCreatePurchase ? '' : 'disabled' %>
                        >
                            <span class="purchase-submit-label">
                                <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                Провести закупку
                            </span>
                            <span class="purchase-submit-loading" hidden>
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                Проводим…
                            </span>
                        </button>
                    </footer>
                </section>
            </div>
        </form>
    </div>
</main>

<template id="purchaseItemTemplate">
    <article class="purchase-item-row">
        <div class="purchase-item-number">
            <span class="purchase-row-number">1</span>
        </div>

        <div class="purchase-item-field purchase-item-field--product">
            <label class="purchase-mobile-label">Товар</label>
            <div class="purchase-product-picker">
                <div class="purchase-product-input-wrap">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input
                        type="text"
                        class="form-control purchase-product-search"
                        placeholder="Название или артикул"
                        autocomplete="off"
                        role="combobox"
                        aria-autocomplete="list"
                        aria-expanded="false"
                        required
                    >
                    <button
                        type="button"
                        class="purchase-product-clear"
                        aria-label="Очистить выбранный товар"
                        title="Очистить"
                        hidden
                    >
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
                <input type="hidden" class="purchase-product-id">
                <div class="purchase-product-options" role="listbox" hidden></div>
                <span class="purchase-item-error" aria-live="polite"></span>
            </div>
        </div>

        <div class="purchase-item-field purchase-item-field--quantity">
            <label class="purchase-mobile-label">Количество</label>
            <input
                type="number"
                class="form-control purchase-quantity"
                value="1"
                min="1"
                max="99999999"
                step="1"
                inputmode="numeric"
                required
            >
        </div>

        <div class="purchase-item-field purchase-item-field--price">
            <label class="purchase-mobile-label">Цена закупки</label>
            <div class="input-group">
                <input
                    type="number"
                    class="form-control purchase-price"
                    value="0.00"
                    min="0"
                    max="99999999.99"
                    step="0.01"
                    inputmode="decimal"
                    required
                >
                <span class="input-group-text">₴</span>
            </div>
        </div>

        <div class="purchase-item-total">
            <span class="purchase-mobile-label">Сумма</span>
            <strong class="purchase-row-total">0,00 ₴</strong>
        </div>

        <div class="purchase-item-actions">
            <button
                type="button"
                class="btn purchase-remove-item"
                aria-label="Удалить позицию"
                title="Удалить позицию"
            >
                <i class="bi bi-trash" aria-hidden="true"></i>
            </button>
        </div>
    </article>
</template>

<script type="application/json" id="purchaseProductsData"><%- productCatalogJson %></script>

<%- include('blocks/footer') -%>
