<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>

<div class="col content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800 fw-bold">🚚 Справочник поставщиков</h1>
        <button type="button" class="btn btn-primary btn-sm px-3 py-2 rounded-2 shadow-sm fw-medium" data-bs-toggle="modal" data-bs-target="#addSupplierModal">
            <i class="bi bi-plus-lg me-1"></i> Добавить поставщика
        </button>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom text-secondary text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                        <tr>
                            <th class="ps-4 py-3 fw-bold">Название</th>
                            <th class="py-3 fw-bold">Телефон</th>
                            <th class="py-3 fw-bold">Email</th>
                            <th class="py-3 fw-bold">Адрес</th>
                            <th class="pe-4 py-3 fw-bold text-end" style="width: 120px;">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (suppliers.length === 0) { %>
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="text-muted opacity-25 mb-3">
                                        <i class="bi bi-truck" style="font-size: 3.5rem;"></i>
                                    </div>
                                    <h5 class="text-secondary fw-semibold mb-1">Список поставщиков пуст</h5>
                                    <p class="text-muted small mb-0">Добавьте первого поставщика, чтобы начать работу с закупками.</p>
                                </td>
                            </tr>
                        <% } else { %>
                            <% suppliers.forEach(supplier => { %>
                                <tr class="border-bottom-0">
                                    <td class="ps-4 fw-bold text-dark"><%= supplier.name %></td>
                                    <td class="text-secondary"><%= supplier.phone || '—' %></td>
                                    <td>
                                        <% if(supplier.email) { %>
                                            <a href="mailto:<%= supplier.email %>" class="text-decoration-none text-primary"><%= supplier.email %></a>
                                        <% } else { %>
                                            <span class="text-muted">—</span>
                                        <% } %>
                                    </td>
                                    <td class="text-muted text-truncate" style="max-width: 250px;"><%= supplier.address || '—' %></td>
                                    <td class="pe-4 text-end">
                                        <div class="btn-group btn-group-sm bg-white border rounded-2 shadow-sm">
                                            <button class="btn btn-link text-secondary p-2 border-0" title="Редактировать">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-link text-danger p-2 border-0" title="Удалить">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addSupplierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-3">
            <form action="/suppliers/add" method="POST">
                <div class="modal-header border-bottom-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold text-gray-800">Новый поставщик</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4">
                    <div class="mb-3">
                        <label for="name" class="form-label small text-uppercase text-muted fw-bold" style="font-size: 0.75rem;">Название компании *</label>
                        <input type="text" class="form-control form-control-solid border rounded-2" id="name" name="name" placeholder="ООО Поставщик" required>
                    </div>
                    <div class="mb-3">
                        <label for="phone" class="form-label small text-uppercase text-muted fw-bold" style="font-size: 0.75rem;">Телефон</label>
                        <input type="text" class="form-control border rounded-2" id="phone" name="phone" placeholder="+380...">
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label small text-uppercase text-muted fw-bold" style="font-size: 0.75rem;">Email</label>
                        <input type="email" class="form-control border rounded-2" id="email" name="email" placeholder="example@mail.com">
                    </div>
                    <div class="mb-3">
                        <label for="address" class="form-label small text-uppercase text-muted fw-bold" style="font-size: 0.75rem;">Фактический адрес</label>
                        <textarea class="form-control border rounded-2" id="address" name="address" rows="2" placeholder="Город, улица..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pb-4 px-4">
                    <button type="button" class="btn btn-light btn-sm px-3 rounded-2" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary btn-sm px-3 rounded-2">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('blocks/footer') -%>