<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>

<div class="col content">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="mb-1">
                    <i class="bi bi-person-gear me-2"></i>Редактирование сотрудника
                </h5>
                <div class="small text-muted">
                    Измените данные, доступ и назначенные магазины
                </div>
            </div>

            <a href="/user/<%= employee.id %>" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Вернуться в профиль
            </a>
        </div>

        <div class="card-body">
            <% if (editError) { %>
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i><%= editError %>
            </div>
            <% } %>

            <form
                method="POST"
                action="/user/<%= employee.id %>/edit"
                enctype="multipart/form-data">

                <div class="row g-3">
                    <div class="col-lg-8">
                        <div class="card shadow-sm border-0 mb-3">
                            <div class="card-header bg-white">
                                <h6 class="mb-0">
                                    <i class="bi bi-person me-2"></i>Личные данные
                                </h6>
                            </div>

                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="employee-name" class="form-label">
                                            ФИО <span class="text-danger">*</span>
                                        </label>
                                        <input
                                            id="employee-name"
                                            type="text"
                                            name="name"
                                            class="form-control"
                                            value="<%= formValues.name %>"
                                            maxlength="100"
                                            required>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="employee-email" class="form-label">Email</label>
                                        <input
                                            id="employee-email"
                                            type="email"
                                            name="email"
                                            class="form-control"
                                            value="<%= formValues.email %>"
                                            maxlength="255">
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="employee-phone" class="form-label">Телефон</label>
                                        <input
                                            id="employee-phone"
                                            type="text"
                                            name="phone"
                                            class="form-control"
                                            value="<%= formValues.phone %>"
                                            maxlength="20">
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="employee-birth-date" class="form-label">
                                            Дата рождения
                                        </label>
                                        <input
                                            id="employee-birth-date"
                                            type="date"
                                            name="birth_date"
                                            class="form-control"
                                            value="<%= formValues.birth_date %>">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-white">
                                <h6 class="mb-0">
                                    <i class="bi bi-briefcase me-2"></i>Рабочая информация
                                </h6>
                            </div>

                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="employee-login" class="form-label">
                                            Логин <span class="text-danger">*</span>
                                        </label>
                                        <input
                                            id="employee-login"
                                            type="text"
                                            name="login"
                                            class="form-control"
                                            value="<%= formValues.login %>"
                                            maxlength="100"
                                            autocomplete="username"
                                            required>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="employee-password" class="form-label">
                                            Новый пароль
                                        </label>
                                        <input
                                            id="employee-password"
                                            type="password"
                                            name="password"
                                            class="form-control"
                                            minlength="6"
                                            autocomplete="new-password">
                                        <div class="form-text">
                                            Оставьте пустым, чтобы сохранить текущий пароль.
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="employee-role" class="form-label">Роль</label>
                                        <select
                                            id="employee-role"
                                            name="role"
                                            class="form-select"
                                            <%= isSelf ? 'disabled' : '' %>>
                                            <option value="seller" <%= formValues.role === 'seller' ? 'selected' : '' %>>
                                                Продавец
                                            </option>
                                            <option value="manager" <%= formValues.role === 'manager' ? 'selected' : '' %>>
                                                Менеджер
                                            </option>
                                            <option value="admin" <%= formValues.role === 'admin' ? 'selected' : '' %>>
                                                Администратор
                                            </option>
                                        </select>
                                        <% if (isSelf) { %>
                                        <input type="hidden" name="role" value="<%= employee.role %>">
                                        <div class="form-text">
                                            Собственную роль изменить нельзя.
                                        </div>
                                        <% } %>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="employee-position" class="form-label">Должность</label>
                                        <input
                                            id="employee-position"
                                            type="text"
                                            name="position"
                                            class="form-control"
                                            value="<%= formValues.position %>"
                                            maxlength="100">
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="employee-salary" class="form-label">Зарплата</label>
                                        <div class="input-group">
                                            <input
                                                id="employee-salary"
                                                type="number"
                                                name="salary"
                                                class="form-control"
                                                value="<%= formValues.salary %>"
                                                min="0"
                                                max="99999999.99"
                                                step="0.01">
                                            <span class="input-group-text">₴</span>
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="employee-hire-date" class="form-label">
                                            Дата приёма
                                        </label>
                                        <input
                                            id="employee-hire-date"
                                            type="date"
                                            name="hire_date"
                                            class="form-control"
                                            value="<%= formValues.hire_date %>">
                                    </div>

                                    <div class="col-12">
                                        <label for="employee-notes" class="form-label">Заметки</label>
                                        <textarea
                                            id="employee-notes"
                                            name="notes"
                                            class="form-control"
                                            rows="4"
                                            maxlength="10000"><%= formValues.notes %></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="card shadow-sm border-0 mb-3">
                            <div class="card-body text-center">
                                <img
                                    src="<%= employee.avatar || '/img/default-avatar.png' %>"
                                    alt="Аватар сотрудника"
                                    class="rounded-circle border mb-3"
                                    width="120"
                                    height="120"
                                    style="object-fit: cover;">

                                <label for="employee-avatar" class="form-label d-block text-start">
                                    Новый аватар
                                </label>
                                <input
                                    id="employee-avatar"
                                    type="file"
                                    name="avatar"
                                    class="form-control"
                                    accept="image/jpeg,image/png,image/webp">
                                <div class="form-text text-start">
                                    JPG, PNG или WEBP, не более 5 МБ.
                                </div>
                            </div>
                        </div>

                        <div class="card shadow-sm border-0 mb-3">
                            <div class="card-header bg-white">
                                <i class="bi bi-shop me-2"></i>Магазины
                            </div>

                            <div class="card-body">
                                <% const activeStores = stores.filter(store => store.status === 'active'); %>
                                <% if (activeStores.length) { %>
                                    <% activeStores.forEach(store => { %>
                                    <div class="form-check mb-2">
                                        <input
                                            id="employee-store-<%= store.id %>"
                                            class="form-check-input"
                                            type="checkbox"
                                            name="stores"
                                            value="<%= store.id %>"
                                            <%= selectedStoreIds.includes(Number(store.id)) ? 'checked' : '' %>>
                                        <label
                                            class="form-check-label"
                                            for="employee-store-<%= store.id %>">
                                            <%= store.name %>
                                        </label>
                                    </div>
                                    <% }) %>
                                <% } else { %>
                                <div class="alert alert-warning mb-0">
                                    Нет активных магазинов.
                                </div>
                                <% } %>

                                <% const inactiveAssignedStores = stores.filter(store => store.status !== 'active' && store.selected); %>
                                <% if (inactiveAssignedStores.length) { %>
                                <hr>
                                <div class="small text-muted mb-2">
                                    Сохранённые назначения неактивных магазинов:
                                </div>
                                    <% inactiveAssignedStores.forEach(store => { %>
                                    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                        <span><%= store.name %></span>
                                        <span class="badge bg-secondary">Неактивен</span>
                                    </div>
                                    <% }) %>
                                <% } %>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle me-1"></i>Сохранить изменения
                            </button>
                            <a href="/user/<%= employee.id %>" class="btn btn-outline-secondary">
                                Отмена
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('blocks/footer') -%>
