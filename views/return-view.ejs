<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>

<div class="col content return-view-page">
    <div class="return-view-shell">
    <header class="return-document-header">
        <div>
            <div class="return-view-eyebrow"><i class="bi bi-arrow-counterclockwise"></i>Документ возврата</div>
            <h1>Возврат № <%= ret.return_number || ret.id %></h1>
            <p><%= new Date(ret.created_at).toLocaleString('ru-RU', { timeZone: 'Europe/Kyiv', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
        </div>
        <div class="return-view-actions">
            <a href="/return" class="return-secondary-action"><i class="bi bi-arrow-left"></i>К возвратам</a>
            <a href="/sales/<%= ret.sale_id %>" class="return-primary-action"><i class="bi bi-receipt"></i>Чек № <%= ret.invoice_number %></a>
        </div>
    </header>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card return-info-card return-info-card--customer h-100"><div class="card-body"><div class="text-muted small">Покупатель</div><div class="fw-semibold"><%= ret.customer_name || 'Розничный покупатель' %></div></div></div>
        </div>
        <div class="col-md-4">
            <div class="card return-info-card return-info-card--store h-100"><div class="card-body"><div class="text-muted small">Магазин</div><div class="fw-semibold"><%= ret.store_name || '—' %></div></div></div>
        </div>
        <div class="col-md-4">
            <div class="card return-info-card return-info-card--user h-100"><div class="card-body"><div class="text-muted small">Оформил</div><div class="fw-semibold"><%= ret.user_name || '—' %></div></div></div>
        </div>
    </div>

    <div class="card return-items-card">
        <div class="return-items-heading"><div><h2>Товары в возврате</h2><p><%= items.length %> позиций в документе</p></div><i class="bi bi-box-arrow-in-left"></i></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 return-items-table">
                <thead class="table-light text-muted small text-uppercase">
                    <tr><th class="ps-3">№</th><th>Артикул</th><th>Товар</th><th class="text-end">Количество</th><th class="text-end">Цена</th><th class="text-end pe-3">Сумма</th></tr>
                </thead>
                <tbody>
                    <% items.forEach((item, index) => { %>
                        <tr>
                            <td class="ps-3"><%= index + 1 %></td>
                            <td><%= item.sku || '—' %></td>
                            <td class="fw-medium"><%= item.name %></td>
                            <td class="text-end"><%= Number(item.quantity) %></td>
                            <td class="text-end"><%= Number(item.price).toFixed(2) %> ₴</td>
                            <td class="text-end pe-3 fw-bold text-danger">-<%= Number(item.subtotal).toFixed(2) %> ₴</td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <div class="card-body border-top d-flex justify-content-end">
            <div class="return-total">Итого возвращено: <span>-<%= Number(ret.total).toFixed(2) %> ₴</span></div>
        </div>
    </div>
    </div>
</div>

<%- include('blocks/footer') -%>
