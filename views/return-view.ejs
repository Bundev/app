<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>

<div class="col content">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-arrow-counterclockwise me-2 text-warning"></i>Возврат № <%= ret.return_number || ret.id %></h2>
            <div class="text-muted"><%= new Date(ret.created_at).toLocaleString('ru-RU', { timeZone: 'Europe/Kyiv', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></div>
        </div>
        <div class="d-flex gap-2">
            <a href="/sales/<%= ret.sale_id %>" class="btn btn-outline-primary"><i class="bi bi-receipt me-1"></i>Чек № <%= ret.invoice_number %></a>
            <a href="/return" class="btn btn-outline-secondary">К возвратам</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm return-info-card h-100"><div class="card-body"><div class="text-muted small">Покупатель</div><div class="fw-semibold"><%= ret.customer_name || 'Розничный покупатель' %></div></div></div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm return-info-card h-100"><div class="card-body"><div class="text-muted small">Магазин</div><div class="fw-semibold"><%= ret.store_name || '—' %></div></div></div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm return-info-card h-100"><div class="card-body"><div class="text-muted small">Оформил</div><div class="fw-semibold"><%= ret.user_name || '—' %></div></div></div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3"><strong>Товары в возврате</strong></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr><th class="ps-3">№</th><th>Артикул</th><th>Товар</th><th class="text-end">Количество</th><th class="text-end">Цена</th><th class="text-end pe-3">Сумма</th></tr>
                </thead>
                <tbody>
                    <% items.forEach((item, index) => { %>
                        <tr>
                            <td class="ps-3"><%= index + 1 %></td>
                            <td><%= item.sku || '—' %></td>
                            <td class="fw-medium"><%= item.name %></td>
                            <td class="text-end"><%= Number(item.quantity) %></td>
                            <td class="text-end"><%= Number(item.price).toFixed(2) %> ₴</td>
                            <td class="text-end pe-3 fw-bold text-danger">-<%= Number(item.subtotal).toFixed(2) %> ₴</td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <div class="card-body border-top d-flex justify-content-end">
            <div class="return-total">Итого возвращено: <span>-<%= Number(ret.total).toFixed(2) %> ₴</span></div>
        </div>
    </div>
</div>

<%- include('blocks/footer') -%>
