<!doctype html>
<html lang="en">
    <head>
       <%- include('blocks/head') -%>
    </head>
    <body>
        <%- include('blocks/header') -%>
        <div class="container-fluid" id="cont">
            <div class="row">
                <div class="col-2">
                <%- include('blocks/menu') -%>
                </div>
                <div class="col-10" >
                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <h2 class="mb-1">
                                        🧾 <%= __('title.invoices') %> №<%= invoiceId %>
                                    </h2>

                                    <small class="text-muted">
                                        от <%= new Date(invoice.date).toLocaleDateString('ru-RU') %>
                                    </small>
                                </div>

                                <div>
                                    <span class="badge <%= statuses[invoice.status].class %>"><%= statuses[invoice.status].title %></span>
                                </div>

                            </div>

                        </div>
                    </div>

                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body">

                            <h5 class="mb-3">
                                Покупатель
                            </h5>

                            <p class="mb-0">
                                <strong><%= invoice.customer %></strong>
                            </p>

                        </div>
                    </div>
<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-white">

        <h5 class="mb-0">
            Управление заказом
        </h5>

    </div>

    <div class="card-body">

        <form action="/invoice/status/<%= invoice.number %>"
              method="POST">

            <div class="row align-items-end">

                <div class="col-md-4">

                    <label class="form-label">
                        Статус заказа
                    </label>

                    <select
                        name="status"
                        class="form-select">

                        <% Object.keys(statuses).forEach(key => { %>

                            <option
                                value="<%= key %>"
                                <%= invoice.status === key ? 'selected' : '' %>>

                                <%= statuses[key].title %>

                            </option>

                        <% }) %>

                    </select>

                </div>

                <div class="col-md-2">

                    <button
                        type="submit"
                        class="btn btn-primary w-100">

                        <i class="bi bi-check-lg"></i>
                        Сохранить

                    </button>

                </div>
                
                <div class="col-md-2">
                    <% if (user && user.role === 'admin') { %>
                    <a href="/invoice/delete/<%= invoice.number %>"
                       class="btn btn-danger w-100"
                       onclick="return confirm('Удалить чек безвозвратно?')">

                        <i class="bi bi-trash"></i>
                        Удалить

                    </a>
                    <% } %>
                </div>
                
            </div>

        </form>

    </div>

</div>

                    <div class="card border-0 shadow-sm">

                        <div class="card-body p-0">

                            <table class="table table-hover mb-0">

                                <thead class="table-light">

                                    <tr>
                                        <th>№</th>
                                        <th>Товар</th>
                                        <th>Кол-во</th>
                                        <th>Цена</th>
                                        <th>Сумма</th>
                                        <th>Действия</th>
                                    </tr>
                                    

                                </thead>

                                <tbody>

                                <% invoice.items.forEach((item,index)=> { %>

                                    <tr>

                                        <td><%= index + 1 %></td>

                                        <td><%= item.name %></td>

                                        <td><%= item.qty %></td>

                                        <td><%= item.price.toFixed(2) %> ₴</td>

                                        <td>
                                            <strong>
                                                <%= item.sum.toFixed(2) %> ₴
                                            </strong>
                                        </td>
                                        <td>
                                            <a href="/invoice/<%= invoice.number %>/delete-item/<%= index %>"
                                            class="btn btn-danger btn-sm"
                                            onclick="return confirm('Удалить товар?')">

                                                <i class="bi bi-trash"></i>

                                            </a>
                                        </td>

                                    </tr>

                                <% }) %>

                                </tbody>
                            </table>
                        </div>
                    </div>
                    
                    
                    <div class="card border-0 shadow-sm mt-4">

                        <div class="card-body">

                            <div class="d-flex justify-content-end">

                                <h3 class="mb-0">

                                    Итого:
                                    <span class="text-primary">
                                        <%= invoice.total.toFixed(2) %> ₴
                                    </span>
                                </h3>
                            </div>
                        </div>
                    </div>
                    

                </div>

            </div>
        </div>
        <%- include('blocks/footer') -%>
    </body>
</html>