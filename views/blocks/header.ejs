<header class="header">
  <nav class="navbar navbar-expand-lg navbar-dark topbar">
    <div class="container-fluid">
      <button class="btn btn-light d-md-none me-2" id="menuToggle">
          ☰
      </button>
      <a class="navbar-brand fw-bold" href="/">
        RetailPro
      </a>

      <div class="ms-auto d-flex align-items-center gap-3">

      <div class="btn-group">
          <a href="/lang/ru"
            class="btn <%= lang === 'ru' ? 'btn-primary' : 'btn-outline-secondary' %>">
              RU
          </a>

          <a href="/lang/uk"
            class="btn <%= lang === 'uk' ? 'btn-primary' : 'btn-outline-secondary' %>">
              UA
          </a>
      </div>

    <div class="dropdown ms-auto">

    <a href="#"
       class="d-flex align-items-center text-decoration-none text-white"
       data-bs-toggle="dropdown">

        <div class="text-end me-3">

            <div class="fw-bold">
                <%= user.name %>
            </div>

            <small class="text-light">
                <%= roles[user.role] %>
            </small>

        </div>

        <img
            src="<%= user.avatar %>"
            class="rounded-circle border"
            width="42"
            height="42">

    </a>

    <ul class="dropdown-menu dropdown-menu-end shadow">
        <li>
            <a class="dropdown-item"
               href="/profile">

                <i class="bi bi-person"></i>
                Профиль

            </a>
        </li>

        <li>
            <a class="dropdown-item"
               href="/settings/profile">

                <i class="bi bi-gear"></i>
                Настройки

            </a>
        </li>

        <li>
            <a class="dropdown-item"
               href="/users">

                <i class="bi bi-people"></i>
                Пользователи

            </a>
        </li>

        <li>
            <hr class="dropdown-divider">
        </li>

        <li>
            <a class="dropdown-item text-danger"
               href="/logout">

                <i class="bi bi-box-arrow-right"></i>
                Выход

            </a>
        </li>

    </ul>

</div>

</div>

    </div>
  </nav>
</header>

<% if (typeof breadcrumbs !== 'undefined' && breadcrumbs.length) { %>
<div class="container-fluid">
<nav aria-label="breadcrumb">
  <ol class="breadcrumb">

    <% breadcrumbs.forEach((item, index) => { %>

      <% if(index === breadcrumbs.length - 1) { %>

        <li class="breadcrumb-item active">
          <%= item.title %>
        </li>

      <% } else { %>

        <li class="breadcrumb-item">
          <a href="<%= item.url %>">
            <%= item.title %>
          </a>
        </li>

      <% } %>

    <% }) %>

  </ol>
</nav>

</div>

<% } %>