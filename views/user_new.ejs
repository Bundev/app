<!doctype html>
<html lang="en">
  <head>
    <%- include('blocks/head') -%>
  </head>
  <body>
    <div id="overlay"></div>
    <%- include('blocks/header') -%>
    <div class="container-fluid" id="cont">
      <div class="row">
        <%- include('blocks/menu') -%>
        <div class="col content">
<div class="card shadow-sm">

    <div class="card-header">

        👤 Новый сотрудник

    </div>

    <div class="card-body">

        <form method="POST" action="/user/new" enctype="multipart/form-data">
<div class="row">

    <div class="col-lg-8">

        <div class="card shadow-sm border-0 mb-3">

            <div class="card-header bg-white">

                <h5 class="mb-0">
                    👤 Личные данные
                </h5>

            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            ФИО
                        </label>

                        <input
                            type="text"
                            name="name"
                            class="form-control">

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Email
                        </label>

                        <input
                            type="email"
                            name="email"
                            class="form-control">

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Телефон
                        </label>

                        <input
                            type="text"
                            name="phone"
                            class="form-control">

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Дата рождения
                        </label>

                        <input
                            type="date"
                            name="birth_date"
                            class="form-control">

                    </div>

                </div>

            </div>

        </div>

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white">

                <h5 class="mb-0">
                    💼 Рабочая информация
                </h5>

            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Логин
                        </label>

                        <input
                            type="text"
                            name="login"
                            class="form-control">

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Пароль
                        </label>

                        <input
                            type="password"
                            name="password"
                            class="form-control">

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Роль
                        </label>

                        <select
                            name="role"
                            class="form-select">

                            <option value="seller">
                                Продавец
                            </option>

                            <option value="manager">
                                Менеджер
                            </option>

                            <option value="admin">
                                Администратор
                            </option>

                        </select>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Зарплата
                        </label>

                        <input
                            type="number"
                            name="salary"
                            class="form-control">

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-4">

        <div class="card shadow-sm border-0 mb-3">

            <div class="card-body text-center">

                <img
                    src="/img/default-avatar.png"
                    class="rounded-circle border mb-3"
                    width="120">

                <input
                    type="file"
                    name="avatar"
                    class="form-control">

            </div>

        </div>

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white">

                🏪 Магазин

            </div>

            <div class="card-body">

                <select
                    name="store_id"
                    class="form-select">

                    <% stores.forEach(store => { %>

                        <option value="<%= store.id %>">

                            <%= store.name %>

                        </option>

                    <% }) %>

                </select>

            </div>

        </div>

        <button
            type="submit"
            class="btn btn-success btn-lg w-100 mt-3">

            💾 Сохранить сотрудника

        </button>

    </div>

</div>
              


            

            
            

        </form>

    </div>

</div>

        </div>
      </div>
    </div>
    <%- include('blocks/footer') -%>
  </body>
</html>