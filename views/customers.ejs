<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>
<div class="col content">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">База клиентов</h1>
            <p class="text-muted small mb-0">Всего зарегистрировано: <%= customers.length %> клиентов</p>
        </div>
        <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#addCustomerModal">
            <i class="bi bi-person-plus-fill me-2"></i>+ Новый client
        </button>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 14px;">
                    <thead class="table-light text-uppercase fs-7 text-muted fw-bold">
                        <tr>
                            <th class="ps-4" style="width: 80px;">ID</th>
                            <th>ФИО / Название</th>
                            <th>Телефон</th>
                            <th>Email</th>
                            <th>Скидка</th>
                            <th>Примечание</th>
                            <th class="pe-4 text-end" style="width: 120px;">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (customers.length === 0) { %>
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">Клиенты еще не добавлены</td>
                            </tr>
                        <% } else { %>
                            <% customers.forEach(customer => { %>
                                <tr>
                                    <td class="ps-4 text-muted">#<%= customer.id %></td>
                                    <td>
                                        <div class="fw-bold text-dark"><%= customer.name %></div>
                                        <div class="text-muted" style="font-size: 11px;">
                                            Создан: <%= customer.created_at ? new Date(customer.created_at).toLocaleDateString('ru-RU') : '—' %>
                                        </div>
                                    </td>
                                    <td class="fw-medium"><%= customer.phone || '—' %></td>
                                    <td><%= customer.email || '—' %></td>
                                    <td>
                                        <span class="badge bg-info text-dark fw-bold">
                                            <%= Number(customer.discount_percentage).toFixed(1) %>%
                                        </span>
                                    </td>
                                    <td class="text-muted" style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        <%= customer.comment || '—' %>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-sm btn-outline-primary border-0 edit-customer-btn" data-id="<%= customer.id %>" title="Редактировать">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            
                                            <% if (customer.id !== 1) { %>
                                                <a href="/customers/archive/<%= customer.id %>" class="btn btn-sm btn-outline-warning border-0" onclick="return confirm('Вы уверены, что хотите перенести этого клиента в архив?')" title="Архивировать">
                                                    <i class="bi bi-archive"></i>
                                                </a>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addCustomerModal" tabindex="-1" aria-labelledby="addCustomerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="addCustomerModalLabel">Новый клиент</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/customers/add" method="POST">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">ФИО / Название компании *</label>
                        <input type="text" name="name" class="form-control" placeholder="Иванов Иван" required autocomplete="off">
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Номер телефона</label>
                            <input type="text" name="phone" class="form-control" placeholder="+380..." autocomplete="off">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Персональная скидка (%)</label>
                            <input type="number" name="discount_percentage" class="form-control" min="0" max="100" step="0.01" placeholder="0.00" value="0">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Email</label>
                        <input type="email" name="email" class="form-control" placeholder="client@example.com" autocomplete="off">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Комментарий / Примечание</label>
                        <textarea name="comment" class="form-control" rows="3" placeholder="Особые условия доставки, контакты руководства..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary px-4">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="editCustomerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold">Редактировать клиента</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editCustomerForm" action="" method="POST">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">ФИО / Название *</label>
                        <input type="text" id="edit_name" name="name" class="form-control" required autocomplete="off">
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Номер телефона</label>
                            <input type="text" id="edit_phone" name="phone" class="form-control" autocomplete="off">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Персональная скидка (%)</label>
                            <input type="number" id="edit_discount" name="discount_percentage" class="form-control" min="0" max="100" step="0.01">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Email</label>
                        <input type="email" id="edit_email" name="email" class="form-control" autocomplete="off">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Комментарий</label>
                        <textarea id="edit_comment" name="comment" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-success px-4">Сохранить изменения</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
document.querySelectorAll('.edit-customer-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        try {
            const res = await fetch(`/api/customers/${id}`);
            if (!res.ok) return alert('Не удалось получить данные клиента');
            const customer = await res.json();

            // Заполняем поля формы данными из БД
            document.getElementById('editCustomerForm').action = `/customers/edit/${id}`;
            document.getElementById('edit_name').value = customer.name || '';
            document.getElementById('edit_phone').value = customer.phone || '';
            document.getElementById('edit_discount').value = customer.discount_percentage || 0;
            document.getElementById('edit_email').value = customer.email || '';
            document.getElementById('edit_comment').value = customer.comment || '';

            // Показываем модалку
            const editModal = new bootstrap.Modal(document.getElementById('editCustomerModal'));
            editModal.show();
        } catch (err) {
            console.error(err);
        }
    });
});
</script>
<%- include('blocks/footer') -%>