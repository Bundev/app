<%- include('blocks/head') -%>

<main class="auth-page auth-page--login">
    <section class="auth-showcase" aria-label="<%= __('auth.aboutSystem') %>">
        <div class="auth-showcase__content">
            <a href="/login" class="auth-brand">
                <span class="auth-brand__mark"><i class="bi bi-shop-window"></i></span>
                <span><strong>RetailPro</strong><small>CRM</small></span>
            </a>
            <div class="auth-showcase__main">
                <span class="auth-eyebrow"><i class="bi bi-stars"></i> <%= __('auth.businessManagement') %></span>
                <h1><%= __('auth.loginHeroTitle') %></h1>
                <p><%= __('auth.loginHeroDescription') %></p>
                <div class="auth-benefits">
                    <span><i class="bi bi-check2-circle"></i> <%= __('auth.cashBenefit') %></span>
                    <span><i class="bi bi-check2-circle"></i> <%= __('auth.stockBenefit') %></span>
                    <span><i class="bi bi-check2-circle"></i> <%= __('auth.customersBenefit') %></span>
                </div>
            </div>
            <small class="auth-showcase__footer">RetailPro CRM · <%= __('auth.secureAccess') %></small>
        </div>
    </section>

    <section class="auth-form-side">
        <div class="auth-language" aria-label="<%= __('auth.interfaceLanguage') %>">
            <a href="/lang/ru" class="<%= lang === 'ru' ? 'active' : '' %>">RU</a>
            <a href="/lang/uk" class="<%= lang === 'uk' ? 'active' : '' %>">UA</a>
        </div>
        <div class="auth-card">
            <div class="auth-mobile-brand">
                <span class="auth-brand__mark"><i class="bi bi-shop-window"></i></span>
                <strong>RetailPro</strong><small>CRM</small>
            </div>
            <header class="auth-card__header">
                <span class="auth-card__icon"><i class="bi bi-box-arrow-in-right"></i></span>
                <h2><%= __('auth.welcome') %></h2>
                <p><%= __('auth.loginSubtitle') %></p>
            </header>

            <% if (typeof error !== 'undefined' && error) { %>
            <div class="auth-alert auth-alert--danger" role="alert">
                <i class="bi bi-exclamation-circle-fill"></i><span><%= error %></span>
            </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
            <div class="auth-alert auth-alert--success" role="alert">
                <i class="bi bi-check-circle-fill"></i><span><%= success %></span>
            </div>
            <% } %>

            <form method="POST" action="/login" class="auth-form">
                <div class="auth-field">
                    <label for="login"><i class="bi bi-person"></i> <%= __('auth.login') %></label>
                    <input id="login" type="text" name="login" class="form-control" autocomplete="username" placeholder="<%= __('auth.loginPlaceholder') %>" required autofocus>
                </div>
                <div class="auth-field">
                    <label for="password"><i class="bi bi-lock"></i> <%= __('auth.password') %></label>
                    <input id="password" type="password" name="password" class="form-control" autocomplete="current-password" placeholder="<%= __('auth.passwordPlaceholder') %>" required>
                </div>
                <button type="submit" class="btn auth-submit"><%= __('auth.signIn') %> <i class="bi bi-arrow-right"></i></button>
            </form>

            <div class="auth-switch"><%= __('auth.noAccount') %> <a href="/register"><%= __('auth.register') %></a></div>
        </div>
    </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
