<!doctype html>
<html lang="ru">

<head>
    <%- include('blocks/head') -%>
</head>

<body class="bg-light">

<div class="container">

    <div class="row vh-100 justify-content-center align-items-center">

        <div class="col-md-4">

            <div class="card shadow border-0">

                <div class="card-body p-4">

                    <div class="text-center mb-4">

                        <h2 class="fw-bold">
                            RetailPro
                        </h2>

                        <p class="text-muted">
                            Вход в CRM
                        </p>

                    </div>

                    <form method="POST" action="/login">

                        <div class="mb-3">

                            <label class="form-label">
                                Логин
                            </label>

                            <input
                                type="text"
                                name="login"
                                class="form-control"
                                required>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Пароль
                            </label>

                            <input
                                type="password"
                                name="password"
                                class="form-control"
                                required>

                        </div>

                        <button
                            type="submit"
                            class="btn btn-primary w-100">

                            Войти

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

<%- include('blocks/footer') -%>

</body>
</html>