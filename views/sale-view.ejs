<!doctype html>
<html lang="ru">

<head>
    <%- include('blocks/head') -%>
</head>

<body>

<%- include('blocks/header') -%>

<div class="container-fluid">

    <div class="row">

        <%- include('blocks/menu') -%>

        <div class="col content">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between mb-4">

                        <h2>
                            🧾 Чек <%= sale.invoice_number %>
                        </h2>

                        <div class="btn-group">

                            <a
                                href="/sales/print/<%= sale.id %>"
                                class="btn btn-outline-success">

                                <i class="bi bi-printer"></i>

                                Печать

                            </a>

                            <a
                                href="/sales/pdf/<%= sale.id %>"
                                class="btn btn-outline-primary">

                                <i class="bi bi-file-earmark-pdf"></i>

                                PDF

                            </a>

                        </div>

                    </div>

                    <div class="row g-3 mb-4">

                        <div class="col-md-3">

                            <div class="card bg-light border-0">

                                <div class="card-body">

                                    <small class="text-muted">
                                        Дата продажи
                                    </small>

                                    <div class="fw-bold">

                                        <%= new Date(sale.created_at)
                                            .toLocaleString('ru-RU') %>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="col-md-3">

                            <div class="card bg-light border-0">

                                <div class="card-body">

                                    <small class="text-muted">
                                        Клиент
                                    </small>

                                    <div class="fw-bold">

                                        <%= sale.customer_name || 'Основной покупатель' %>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="col-md-3">

                            <div class="card bg-light border-0">

                                <div class="card-body">

                                    <small class="text-muted">
                                        Магазин
                                    </small>

                                    <div class="fw-bold">

                                        <%= sale.store_name %>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="col-md-3">

                            <div class="card bg-light border-0">

                                <div class="card-body">

                                    <small class="text-muted">
                                        Оплата
                                    </small>

                                    <div class="fw-bold">

                                        <% if(sale.payment_method === 'cash') { %>
                                            Наличные
                                        <% } else if(sale.payment_method === 'card'){%>
                                            Карта
                                        <%} else if(sale.payment_method === 'transfer'){%>
                                            Первод
                                        <%}%>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead class="table-primary">

                                <tr>

                                    <th>№</th>
                                    <th>Артикул</th>
                                    <th>Товар</th>
                                    <th>Кол-во</th>
                                    <th>Цена</th>
                                    <th>Сумма</th>

                                </tr>

                            </thead>

                            <tbody>

                            <% items.forEach((item,index) => { %>

                                <tr>

                                    <td>
                                        <%= index + 1 %>
                                    </td>

                                    <td>
                                        <%= item.sku || '-' %>
                                    </td>

                                    <td class="product-name-copy" data-name="<%= item.name %>" title="Двойной клик для копирования">
                                        <%= item.name %>
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            <%= item.quantity %>
                                        </span>
                                    </td>

                                    <td>
                                        <%= Number(item.price).toFixed(2) %> ₴
                                    </td>

                                    <td class="fw-bold">

                                        <%= Number(item.subtotal).toFixed(2) %> ₴

                                    </td>

                                </tr>

                            <% }) %>

                            </tbody>

                        </table>

                    </div>

                    <div class="row mt-4">

                        <div class="col-md-4 ms-auto">

                            <div class="card border-primary shadow-sm">

                                <div class="card-body text-end">

                                    <div class="mb-2">

                                        Товаров:
                                        <strong>
                                            <%= items.length %>
                                        </strong>

                                    </div>

                                    <h2 class="text-primary mb-0">

                                        Итого:
                                        <%= Number(sale.total).toFixed(2) %> ₴

                                    </h2>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<%- include('blocks/footer') -%>

</body>
</html>