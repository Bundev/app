
<%- include('blocks/head') -%>
<%- include('blocks/header') -%>
<%- include('blocks/menu') -%>
<div class="col content settings-page">

    <header class="settings-page-header">
        <div>
            <div class="settings-page-eyebrow"><i class="bi bi-sliders2"></i> Центр управления</div>
            <h1>Настройки CRM</h1>
            <p>Компания, сотрудники, магазины и параметры работы системы</p>
        </div>
        <div class="settings-page-status">
            <span class="settings-page-status__icon"><i class="bi bi-shield-check"></i></span>
            <span><small>Режим доступа</small><strong>Администратор</strong></span>
        </div>
    </header>


    <h2 class="settings-legacy-title visually-hidden">

        <i class="bi bi-gear-fill"></i>

        Настройки CRM

    </h2>

    <div class="row g-4 settings-layout">

        <div class="col-lg-3 settings-navigation-column">

            <div class="list-group shadow-sm settings-nav">

                <a href="#company"
                class="list-group-item list-group-item-action <%= activeSettingsTab === 'company' ? 'active' : '' %>"
                data-bs-toggle="list">

                    🏢 Компания

                </a>

                <a href="#users"
                class="list-group-item list-group-item-action <%= activeSettingsTab === 'users' ? 'active' : '' %>"
                data-bs-toggle="list">

                    👥 Сотрудники

                </a>

                <a href="#stores"
                class="list-group-item list-group-item-action <%= activeSettingsTab === 'stores' ? 'active' : '' %>"
                data-bs-toggle="list">

                    🏪 Магазины

                </a>

                <a href="#payments"
                class="list-group-item list-group-item-action <%= activeSettingsTab === 'payments' ? 'active' : '' %>"
                data-bs-toggle="list">

                    💳 Способы оплаты

                </a>

                <a href="#statuses"
                class="list-group-item list-group-item-action statuses <%= activeSettingsTab === 'statuses' ? 'active' : '' %>"
                data-bs-toggle="list">

                    📄 Статусы заказов

                </a>

                <a href="#invoice"
                class="list-group-item list-group-item-action <%= activeSettingsTab === 'invoice' ? 'active' : '' %>"
                data-bs-toggle="list">

                    🧾 Нумерация чеков

                </a>

                <a href="#language"
                class="list-group-item list-group-item-action <%= activeSettingsTab === 'language' ? 'active' : '' %>"
                data-bs-toggle="list">

                    🌍 Локализация

                </a>

                <a href="#security"
                class="list-group-item list-group-item-action <%= activeSettingsTab === 'security' ? 'active' : '' %>"
                data-bs-toggle="list">

                    🔒 Права доступа

                </a>

            </div>

        </div>

        <div class="col-lg-9 settings-content-column">

            <div class="tab-content">

                <!-- Компания -->
                <div class="tab-pane fade <%= activeSettingsTab === 'company' ? 'show active' : '' %>"
                    id="company">

                    <div class="card shadow-sm border-0 settings-panel">

                        <div class="card-header settings-panel__header d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <div>
                                <h5 class="settings-panel__title"><i class="bi bi-building me-2"></i>Данные компании</h5>
                                <p class="settings-panel__description">Основная информация об организации</p>
                            </div>
                            <a href="/settings/backup" class="btn btn-outline-primary btn-sm settings-backup-button">
                                <i class="bi bi-cloud-arrow-down me-1"></i><%= __('backup.download') %>
                            </a>
                        </div>

                        <div class="card-body">

                            <% if (companySuccess) { %>
                                <div class="alert alert-success" role="alert">
                                    <i class="bi bi-check-circle-fill me-2"></i><%= companySuccess %>
                                </div>
                            <% } %>

                            <% if (companyError) { %>
                                <div class="alert alert-danger" role="alert">
                                    <i class="bi bi-exclamation-circle-fill me-2"></i><%= companyError %>
                                </div>
                            <% } %>

                            <% if (backupSuccess) { %>
                                <div class="alert alert-success" role="alert">
                                    <i class="bi bi-check-circle-fill me-2"></i><%= backupSuccess %>
                                </div>
                            <% } %>

                            <% if (backupError) { %>
                                <div class="alert alert-danger" role="alert">
                                    <i class="bi bi-exclamation-circle-fill me-2"></i><%= backupError %>
                                </div>
                            <% } %>

                            <% if (company) { %>
                            <div class="settings-backup-note">
                                <span><i class="bi bi-shield-check"></i></span>
                                <div>
                                    <strong><%= __('backup.title') %></strong>
                                    <small><%= __('backup.description') %></small>
                                </div>
                            </div>
                            <form
                                method="POST"
                                action="/settings/backup/import"
                                enctype="multipart/form-data"
                                class="settings-backup-import"
                                onsubmit="return confirm('<%= __('backup.importConfirm') %>');">
                                <div>
                                    <label for="companyBackupFile" class="form-label"><%= __('backup.importLabel') %></label>
                                    <input id="companyBackupFile" type="file" name="backup" class="form-control" accept="application/json,.json" required>
                                    <small><%= __('backup.importHint') %></small>
                                </div>
                                <button type="submit" class="btn btn-outline-success">
                                    <i class="bi bi-cloud-arrow-up me-1"></i><%= __('backup.import') %>
                                </button>
                            </form>
                            <form method="POST" action="/settings/company">
                            <div class="mb-3">

                                <label class="form-label">

                                    Название компании

                                </label>

                                <input
                                    type="text"
                                    name="name"
                                    class="form-control"
                                    value="<%= company.name %>"
                                    maxlength="255"
                                    required>

                            </div>

                            <div class="company-meta mb-3">
                                <span class="badge <%= company.status === 'active' ? 'bg-success' : 'bg-danger' %>">
                                    <%= company.status === 'active' ? 'Активна' : 'Заблокирована' %>
                                </span>

                                <% if (company.created_at) { %>
                                    <span class="text-muted ms-2">Создана: <%= new Date(company.created_at).toLocaleDateString('ru-RU') %></span>
                                <% } %>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-floppy me-1"></i>Сохранить
                            </button>
                            </form>
                            <% } else { %>
                                <div class="alert alert-warning mb-0" role="alert">
                                    Не удалось найти данные компании.
                                </div>
                            <% } %>
                        </div>

                    </div>

                </div>







                <!-- Пользователи -->
                <div class="tab-pane fade <%= activeSettingsTab === 'users' ? 'show active' : '' %>" id="users">

                    <div class="card shadow-sm border-0 settings-panel employees-card">

                        <div class="card-header bg-white settings-panel__header">

                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                                <div>
                                    <h5 class="mb-1">Сотрудники</h5>
                                    <p class="text-muted small mb-0">
                                        Управляйте доступом и данными команды
                                    </p>
                                </div>

                                <a
                                    href="/user/new"
                                    class="btn btn-primary text-nowrap">

                                    <i class="bi bi-person-plus me-1"></i>Добавить сотрудника

                                </a>

                            </div>

                        </div>

                        <% if (users.length) { %>
                        <div class="employees-summary">
                            <span>Всего: <strong><%= users.length %></strong></span>
                            <span class="employees-summary__active">
                                <i class="bi bi-circle-fill"></i>
                                Активных: <%= users.filter(user => user.status === 'active').length %>
                            </span>
                        </div>

                        <div class="employees-list">
                            <% users.forEach(user => { %>
                            <article class="employee-row">
                                <img
                                    src="<%= user.avatar || '/img/default-avatar.png' %>"
                                    alt="Аватар сотрудника <%= user.name %>"
                                    class="employee-avatar">

                                <div class="employee-main">
                                    <a href="/user/<%= user.id %>" class="employee-name"><%= user.name %></a>
                                    <div class="employee-login">@<%= user.login %></div>
                                </div>

                                <div class="employee-contact">
                                    <% if (user.email) { %>
                                        <a href="mailto:<%= user.email %>"><i class="bi bi-envelope"></i><%= user.email %></a>
                                    <% } else if (user.phone) { %>
                                        <a href="tel:<%= user.phone %>"><i class="bi bi-telephone"></i><%= user.phone %></a>
                                    <% } else { %>
                                        <span class="text-muted">Контакты не указаны</span>
                                    <% } %>
                                </div>

                                <div class="employee-labels">
                                    <span class="employee-role role-<%= user.role %>"><%= roles[user.role] || user.role %></span>
                                    <span class="employee-status status-<%= user.status %>">
                                        <i class="bi bi-circle-fill"></i>
                                        <%= user.status === 'active' ? 'Активен' : 'Заблокирован' %>
                                    </span>
                                </div>

                                <div class="employee-actions" aria-label="Действия с сотрудником">
                                    <a href="/user/<%= user.id %>" class="btn btn-sm btn-outline-primary" title="Открыть профиль" aria-label="Открыть профиль <%= user.name %>">
                                        <i class="bi bi-box-arrow-up-right me-1"></i>
                                    </a>
                                    <a href="/user/<%= user.id %>/edit" class="btn btn-sm btn-outline-secondary" title="Редактировать сотрудника" aria-label="Редактировать сотрудника <%= user.name %>">
                                        <i class="bi bi-pencil me-1"></i>
                                    </a>
                                </div>
                            </article>
                            <% }) %>
                        </div>
                        <% } else { %>
                        <div class="employees-empty text-center">
                            <div class="employees-empty__icon"><i class="bi bi-people"></i></div>
                            <h6>Сотрудников пока нет</h6>
                            <p class="text-muted mb-3">Добавьте первого сотрудника, чтобы назначить ему роль и доступ.</p>
                            <a href="/user/new" class="btn btn-primary btn-sm">Добавить сотрудника</a>
                        </div>
                        <% } %>

                    </div>

                </div>




                <div class="tab-pane fade <%= activeSettingsTab === 'stores' ? 'show active' : '' %>" id="stores">
                    <div class="card shadow-sm border-0 settings-panel">
                        <div class="card-header settings-panel__header d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <div>
                                <h5 class="settings-panel__title"><i class="bi bi-shop me-2"></i>Магазины</h5>
                                <p class="settings-panel__description">Точки продаж вашей компании</p>
                            </div>

                            <a
                                href="/stores/new"
                                class="btn btn-primary btn-sm text-nowrap">

                                <i class="bi bi-plus-lg me-1"></i>Добавить магазин

                            </a>

                        </div>

                        <% if (stores.length) { %>
                        <% const activeStoreCount = stores.filter(store => store.status === 'active').length; %>
                        <% if (storeSuccess) { %>
                        <div class="alert alert-success settings-alert mb-0" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i><%= storeSuccess %>
                        </div>
                        <% } %>

                        <% if (storeError) { %>
                        <div class="alert alert-danger settings-alert mb-0" role="alert">
                            <i class="bi bi-exclamation-circle-fill me-2"></i><%= storeError %>
                        </div>
                        <% } %>

                        <div class="employees-summary stores-summary">
                            <span>Всего: <strong><%= stores.length %></strong></span>
                            <span class="employees-summary__active">
                                <i class="bi bi-circle-fill"></i>
                                Активных: <%= activeStoreCount %>
                            </span>
                            <span class="stores-summary__inactive">
                                <i class="bi bi-circle-fill"></i>
                                Неактивных: <%= stores.filter(store => store.status !== 'active').length %>
                            </span>
                        </div>

                        <div class="table-responsive settings-table-wrap">

                        <table class="table table-hover align-middle mb-0 settings-table">
                            <thead>
                                <tr>
                                    
                                    <th>Название</th>
                                    <th>Адрес</th>
                                    <th>Телефон</th>
                                    <th>Статус</th>
                                    <th class="text-end">Действия</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% stores.forEach(store => { %>
                                <tr>
                                    <td>
                                        <strong><%= store.name %></strong>
                                    </td>

                                    <td><%= store.address %></td>

                                    <td>
                                        <a href="tel:<%= store.phone %>">
                                            <%= store.phone %>
                                        </a>
                                    </td>

                                    <td>
                                        <span class="employee-status status-<%= store.status === 'active' ? 'active' : 'blocked' %>">
                                            <i class="bi bi-circle-fill"></i><%= store.status === 'active' ? 'Активен' : 'Неактивен' %>
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <div class="settings-table-actions">
                                            <a href="/stores/<%= store.id %>/edit" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil me-1"></i>Изменить
                                            </a>
                                            <% if (store.status === 'active') { %>
                                            <% const isLastActiveStore = activeStoreCount <= 1; %>
                                            <form method="POST" action="/stores/<%= store.id %>/deactivate" onsubmit="return confirm('Деактивировать магазин? Данные и история сохранятся.');">
                                                <button
                                                    type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    <%= isLastActiveStore ? 'disabled' : '' %>
                                                    title="<%= isLastActiveStore ? 'Последний активный магазин нельзя деактивировать' : 'Деактивировать магазин' %>">
                                                    <i class="bi bi-pause-circle me-1"></i>Деактивировать
                                                </button>
                                            </form>
                                            <% } else { %>
                                            <form method="POST" action="/stores/<%= store.id %>/activate" onsubmit="return confirm('Активировать магазин?');">
                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-play-circle me-1"></i>Активировать
                                                </button>
                                            </form>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>

                        </table>
                            

                        </div>
                        <% } else { %>
                        <div class="settings-empty text-center">
                            <div class="settings-empty__icon"><i class="bi bi-shop"></i></div>
                            <h6>Магазинов пока нет</h6>
                            <p class="text-muted mb-3">Добавьте точку продаж, чтобы вести учёт остатков и продаж.</p>
                            <a href="/stores/new" class="btn btn-primary btn-sm">Добавить магазин</a>
                        </div>
                        <% } %>

                    </div>

                </div>

                <!-- Способы оплаты -->
                <div class="tab-pane fade <%= activeSettingsTab === 'payments' ? 'show active' : '' %>"
                    id="payments">

                    <div class="card shadow-sm border-0 settings-panel">

                        <div class="card-header settings-panel__header">
                            <h5 class="settings-panel__title"><i class="bi bi-credit-card me-2"></i>Способы оплаты</h5>
                            <p class="settings-panel__description">Выберите варианты оплаты, доступные при продаже</p>
                        </div>

                        <div class="card-body">

                            <div class="settings-option form-check">

                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    checked>

                                <label class="form-check-label">

                                    💵 Наличные

                                </label>

                            </div>

                            <div class="settings-option form-check">

                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    checked>

                                <label class="form-check-label">

                                    💳 Карта

                                </label>

                            </div>

                            <div class="settings-option form-check">

                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    checked>

                                <label class="form-check-label">

                                    🏦 Перевод

                                </label>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Статусы -->
                <div class="tab-pane fade <%= activeSettingsTab === 'statuses' ? 'show active' : '' %>"
                    id="statuses">

                    <div class="card shadow-sm border-0 settings-panel">

                        <div class="card-header settings-panel__header">
                            <h5 class="settings-panel__title"><i class="bi bi-card-checklist me-2"></i>Статусы заказов</h5>
                            <p class="settings-panel__description">Последовательность этапов обработки заказа</p>
                        </div>

                        <div class="card-body">

                            <ul class="list-group settings-list">

                                <li class="list-group-item">
                                    Новый
                                </li>

                                <li class="list-group-item">
                                    В обработке
                                </li>

                                <li class="list-group-item">
                                    Собирается
                                </li>

                                <li class="list-group-item">
                                    Готов к выдаче
                                </li>

                                <li class="list-group-item">
                                    Выполнен
                                </li>

                                <li class="list-group-item">
                                    Отменён
                                </li>

                            </ul>

                        </div>

                    </div>

                </div>

                <!-- Нумерация -->
                <div class="tab-pane fade <%= activeSettingsTab === 'invoice' ? 'show active' : '' %>"
                    id="invoice">

                    <div class="card shadow-sm border-0 settings-panel">

                        <div class="card-header settings-panel__header">
                            <h5 class="settings-panel__title"><i class="bi bi-receipt me-2"></i>Нумерация чеков</h5>
                            <p class="settings-panel__description">Префикс будет добавлен перед номером каждого чека</p>
                        </div>

                        <div class="card-body">

                            <div class="settings-field">
                                <label class="form-label">Префикс чека</label>
                                <input type="text" class="form-control" value="INV" aria-describedby="invoice-prefix-help">
                                <div id="invoice-prefix-help" class="form-text">Например: INV-2026-0001</div>
                            </div>

                        </div>

                    </div>

                </div>

                <!-- Локализация -->
                <div class="tab-pane fade <%= activeSettingsTab === 'language' ? 'show active' : '' %>" id="language">
                    <div class="card shadow-sm border-0 settings-panel">
                        <div class="card-header settings-panel__header">
                            <h5 class="settings-panel__title"><i class="bi bi-translate me-2"></i>Локализация</h5>
                            <p class="settings-panel__description">Язык интерфейса и региональные параметры</p>
                        </div>
                        <div class="card-body">
                            <div class="settings-field">
                                <label class="form-label">Язык интерфейса</label>
                                <div class="settings-choice-group">
                                    <a href="/lang/ru" class="btn <%= lang === 'ru' ? 'btn-primary' : 'btn-outline-secondary' %>">Русский</a>
                                    <a href="/lang/uk" class="btn <%= lang === 'uk' ? 'btn-primary' : 'btn-outline-secondary' %>">Українська</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Права доступа -->
                <div class="tab-pane fade <%= activeSettingsTab === 'security' ? 'show active' : '' %>" id="security">
                    <div class="card shadow-sm border-0 settings-panel">
                        <div class="card-header settings-panel__header">
                            <h5 class="settings-panel__title"><i class="bi bi-shield-lock me-2"></i>Права доступа</h5>
                            <p class="settings-panel__description">Роли определяют, какие разделы доступны сотрудникам</p>
                        </div>
                        <div class="card-body">
                            <div class="settings-permissions">
                                <div><span class="employee-role role-admin">Администратор</span><span>Полный доступ к настройкам и данным компании</span></div>
                                <div><span class="employee-role role-manager">Менеджер</span><span>Работа с заказами, товарами и клиентами</span></div>
                                <div><span class="employee-role role-seller">Продавец</span><span>Оформление продаж и работа с кассой</span></div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>


<%- include('blocks/footer') -%>
